<Window
	x:Class               ="DataGenerator.MainWindow"
	xmlns                 ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x               ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d               ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc              ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure  ="clr-namespace:DataGenerator.Infrastructure"
	mc:Ignorable          ="d"
	Title                 ="SQL Test Data Generator"
	Width                 ="1400"
	Height                ="850"
	MinWidth              ="900"
	MinHeight             ="600"
	WindowStartupLocation ="CenterScreen">

	<Grid
		Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>

		<GroupBox
			Grid.Row="0"
			Header="SQL Server connection">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row          ="0"
					Grid.Column       ="0"
					Margin            ="4"
					VerticalAlignment ="Center"
					Text              ="Server:" />

				<TextBox
					Grid.Row    ="0"
					Grid.Column ="1"
					MinWidth    ="180"
					Text        ="{Binding	ServerName,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row          ="0"
					Grid.Column       ="2"
					Margin            ="4"
					VerticalAlignment ="Center"
					Text              ="SQL user:" />

				<TextBox
					Grid.Row    ="0"
					Grid.Column ="3"
					MinWidth    ="120"
					Text        ="{Binding	UserName,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row          ="0"
					Grid.Column       ="4"
					Margin            ="4"
					VerticalAlignment ="Center"
					Text              ="Password:" />

				<PasswordBox
					Grid.Row    ="0"
					Grid.Column ="5"
					MinWidth    ="120"
					infrastructure:PasswordBoxBinding.BindPassword  ="True"
					infrastructure:PasswordBoxBinding.BoundPassword ="{Binding	Password,
																									Mode=TwoWay,
																									UpdateSourceTrigger=PropertyChanged}" />

				<Button
					Grid.Row    ="0"
					Grid.Column ="6"
					Command     ="{Binding LoadMetadataCommand}"
					Content     ="Load metadata" />

				<WrapPanel
					Grid.Row        ="1"
					Grid.Column     ="0"
					Grid.ColumnSpan ="7">
					<CheckBox
						IsChecked ="{Binding	EncryptConnection,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}"
						Content   ="Encrypt connection" />

					<CheckBox
						IsChecked ="{Binding	TrustServerCertificate,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}"
						Content   ="Trust server certificate" />

					<TextBlock
						Margin            ="8,4"
						VerticalAlignment ="Center"
						Foreground        ="DimGray"
						TextWrapping      ="Wrap"
						Text              ="Credentials remain in process memory and are not written to configuration files." />
				</WrapPanel>
			</Grid>
		</GroupBox>

		<Grid
			Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="0.9*" />
				<ColumnDefinition
					Width="2.1*" />
			</Grid.ColumnDefinitions>

			<GroupBox
				Grid.Column="0"
				Header="Databases and tables">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>

					<ComboBox
						Grid.Row          ="0"
						ItemsSource       ="{Binding Databases}"
						SelectedItem      ="{Binding	SelectedDatabase,
																Mode=TwoWay}"
						DisplayMemberPath ="Name" />

					<ListBox
						Grid.Row     ="1"
						ItemsSource  ="{Binding SelectedDatabase.Tables}"
						SelectedItem ="{Binding	SelectedTable,
														Mode=TwoWay}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto"
						ScrollViewer.VerticalScrollBarVisibility="Auto">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid
									Margin="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="Auto" />
										<ColumnDefinition
											Width="*" />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>

									<CheckBox
										Grid.Column ="0"
										IsChecked   ="{Binding	IsSelected,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}" />

									<TextBlock
										Grid.Column       ="1"
										Margin            ="6,0"
										VerticalAlignment ="Center"
										Text              ="{Binding FullyQualifiedName}"
										TextTrimming      ="CharacterEllipsis"
										ToolTip           ="{Binding FullyQualifiedName}" />

									<StackPanel
										Grid.Column ="2"
										Orientation ="Horizontal">
										<TextBlock
											VerticalAlignment="Center"
											Text="Rows:" />

										<TextBox
											Width ="65"
											Text  ="{Binding	RowCount,
																	Mode=TwoWay,
																	UpdateSourceTrigger=LostFocus}" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</GroupBox>

			<GroupBox
				Grid.Column="1"
				Header="Selected table column rules">
				<DataGrid
					ItemsSource                   ="{Binding SelectedTable.Columns}"
					AutoGenerateColumns           ="False"
					CanUserAddRows                ="False"
					CanUserDeleteRows             ="False"
					CanUserReorderColumns         ="True"
					HeadersVisibility             ="Column"
					HorizontalScrollBarVisibility ="Auto"
					VerticalScrollBarVisibility   ="Auto">
					<DataGrid.Columns>
						<DataGridTextColumn
							Header     ="Column"
							Binding    ="{Binding Name}"
							IsReadOnly ="True"
							Width      ="1.2*" />

						<DataGridTextColumn
							Header     ="SQL type"
							Binding    ="{Binding SqlType}"
							IsReadOnly ="True"
							Width      ="*" />

						<DataGridCheckBoxColumn
							Header     ="PK"
							Binding    ="{Binding IsPrimaryKey}"
							IsReadOnly ="True"
							Width      ="50" />

						<DataGridCheckBoxColumn
							Header     ="FK"
							Binding    ="{Binding IsForeignKey}"
							IsReadOnly ="True"
							Width      ="50" />

						<DataGridCheckBoxColumn
							Header     ="Nullable"
							Binding    ="{Binding IsNullable}"
							IsReadOnly ="True"
							Width      ="75" />

						<DataGridTemplateColumn
							Header="Generation mode"
							Width="1.3*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock
										Margin            ="4,0"
										VerticalAlignment ="Center"
										Text              ="{Binding GenerationMode}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>

							<DataGridTemplateColumn.CellEditingTemplate>
								<DataTemplate>
									<ComboBox
										ItemsSource  ="{Binding	DataContext.ValueGenerationModes,
																		RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
										SelectedItem ="{Binding	GenerationMode,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellEditingTemplate>
						</DataGridTemplateColumn>

						<DataGridTextColumn
							Header  ="Fixed value"
							Binding ="{Binding	FixedValue,
														Mode=TwoWay,
														UpdateSourceTrigger=PropertyChanged}"
							Width   ="1.3*" />

						<DataGridTextColumn
							Header  ="Sequence start"
							Binding ="{Binding	SequenceStart,
														Mode=TwoWay,
														UpdateSourceTrigger=LostFocus}"
							Width   ="100" />

						<DataGridTextColumn
							Header  ="Step"
							Binding ="{Binding	SequenceStep,
														Mode=TwoWay,
														UpdateSourceTrigger=LostFocus}"
							Width   ="70" />

						<DataGridTextColumn
							Header  ="Regex"
							Binding ="{Binding	RegexPattern,
														Mode=TwoWay,
														UpdateSourceTrigger=PropertyChanged}"
							Width   ="1.5*" />
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>
		</Grid>

		<GroupBox
			Grid.Row="2"
			Header="Generation output">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row          ="0"
					Grid.Column       ="0"
					Margin            ="4"
					VerticalAlignment ="Center"
					Text              ="Mode:" />

				<ComboBox
					Grid.Row            ="0"
					Grid.Column         ="1"
					HorizontalAlignment ="Left"
					MinWidth            ="160"
					ItemsSource         ="{Binding GenerationModes}"
					SelectedItem        ="{Binding	GenerationMode,
																Mode=TwoWay,
																UpdateSourceTrigger=PropertyChanged}" />

				<CheckBox
					Grid.Row        ="0"
					Grid.Column     ="2"
					Grid.ColumnSpan ="2"
					IsChecked       ="{Binding	ConfirmTestDatabase,
														Mode=TwoWay,
														UpdateSourceTrigger=PropertyChanged}"
					Visibility      ="{Binding	IsDirectInsertMode,
														Converter={StaticResource BooleanToVisibilityConverter}}"
					Content         ="I confirm this is an authorised non-production or test database." />

				<TextBlock
					Grid.Row          ="1"
					Grid.Column       ="0"
					Margin            ="4"
					VerticalAlignment ="Center"
					Text              ="SQL file:"
					Visibility        ="{Binding	IsSqlFileMode,
															Converter={StaticResource BooleanToVisibilityConverter}}" />

				<TextBox
					Grid.Row    ="1"
					Grid.Column ="1"
					Text        ="{Binding	OutputFilePath,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}"
					Visibility  ="{Binding	IsSqlFileMode,
													Converter={StaticResource BooleanToVisibilityConverter}}" />

				<Button
					Grid.Row    ="1"
					Grid.Column ="2"
					Command     ="{Binding BrowseOutputCommand}"
					Content     ="Browse..."
					Visibility  ="{Binding	IsSqlFileMode,
													Converter={StaticResource BooleanToVisibilityConverter}}" />

				<StackPanel
					Grid.Row    ="1"
					Grid.Column ="3"
					Orientation ="Horizontal">
					<Button
						Command ="{Binding GenerateCommand}"
						Content ="Generate" />

					<Button
						Command ="{Binding CancelCommand}"
						Content ="Cancel" />
				</StackPanel>

				<Grid
					Grid.Row        ="2"
					Grid.Column     ="0"
					Grid.ColumnSpan ="4"
					Margin          ="4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>

					<ProgressBar
						Grid.Column     ="0"
						Width           ="120"
						Height          ="16"
						Margin          ="4"
						IsIndeterminate ="True"
						Visibility      ="{Binding	IsBusy,
															Converter={StaticResource BooleanToVisibilityConverter}}" />

					<StackPanel
						Grid.Column="1">
						<TextBlock
							Text         ="{Binding StatusMessage}"
							TextWrapping ="Wrap" />

						<TextBlock
							Margin       ="0,4,0,0"
							Foreground   ="Firebrick"
							FontWeight   ="SemiBold"
							Text         ="{Binding ErrorMessage}"
							TextWrapping ="Wrap" />
					</StackPanel>
				</Grid>
			</Grid>
		</GroupBox>
	</Grid>
</Window>