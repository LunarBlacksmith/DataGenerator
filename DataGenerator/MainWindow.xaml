<Window
	x:Class               ="DataGenerator.MainWindow"
	xmlns                 ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x               ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d               ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc              ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure  ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels      ="clr-namespace:DataGenerator.ViewModels"
	xmlns:views           ="clr-namespace:DataGenerator.Views"
	mc:Ignorable          ="d"
	d:DataContext         ="{d:DesignInstance Type=viewModels:MainViewModel}"
	Title                 ="SQL Test Data Generator"
	Width                 ="1400"
	Height                ="850"
	MinWidth              ="900"
	MinHeight             ="600"
	Background            ="{DynamicResource WindowBackgroundBrush}"
	Foreground            ="{DynamicResource TextBrush}"
	UseLayoutRounding     ="True"
	WindowStartupLocation ="CenterScreen">

	<!-- Window layout: the work area on top, the status bar at the bottom -->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>

		<!--
			Work area: the connection panel across the top, the database explorer (left) and column rules (right)
			separated by a splitter, then the error panel (only while there is an error) and the output panel.
		-->
		<Grid
			Grid.Row ="0"
			Margin   ="8,8,8,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width    ="*"
					MinWidth ="340" />
				<ColumnDefinition
					Width="6" />
				<ColumnDefinition
					Width    ="2*"
					MinWidth ="460" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<views:ConnectionPanel
				Grid.Row        ="0"
				Grid.Column     ="0"
				Grid.ColumnSpan ="3" />

			<!-- The explorer and the column rules both work on the same DatabaseExplorerViewModel -->
			<views:DatabaseExplorerPanel
				Grid.Row    ="1"
				Grid.Column ="0"
				DataContext ="{Binding Explorer}" />

			<GridSplitter
				Grid.Row        ="1"
				Grid.Column     ="1"
				Width           ="6"
				Margin          ="0,0,0,8"
				ResizeBehavior  ="PreviousAndNext"
				ResizeDirection ="Columns"
				Style           ="{StaticResource VerticalSplitterStyle}"
				ToolTip         ="{StaticResource SplitterHint}" />

			<views:ColumnRulesPanel
				Grid.Row    ="1"
				Grid.Column ="2"
				DataContext ="{Binding Explorer}" />

			<!-- Shown only while MainViewModel.HasError is true; its text scrolls, so the rest of the window keeps its size -->
			<views:ErrorPanel
				Grid.Row        ="2"
				Grid.Column     ="0"
				Grid.ColumnSpan ="3"
				Visibility      ="{Binding	HasError,
													Converter={StaticResource BooleanToVisibilityConverter}}" />

			<views:OutputPanel
				Grid.Row        ="3"
				Grid.Column     ="0"
				Grid.ColumnSpan ="3" />
		</Grid>

		<!-- Status bar: theme toggle and busy indicator on the right; the latest status message fills the rest -->
		<Border
			Grid.Row        ="1"
			Padding         ="10,4"
			Background      ="{DynamicResource StatusBarBrush}"
			BorderBrush     ="{DynamicResource StatusBarBorderBrush}"
			BorderThickness ="0,1,0,0">
			<DockPanel>
				<ToggleButton
					DockPanel.Dock ="Right"
					Margin         ="10,0,0,0"
					Padding        ="6,1"
					Content        ="Dark theme"
					IsChecked      ="{Binding	Theme.IsDarkTheme,
														Mode=TwoWay}"
					Style          ="{StaticResource ToolbarToggleButtonStyle}"
					ToolTip        ="{StaticResource ThemeToggleHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE708;" />

				<ProgressBar
					DockPanel.Dock  ="Right"
					Width           ="140"
					Height          ="12"
					Margin          ="10,0,0,0"
					IsIndeterminate ="True"
					Visibility      ="{Binding	IsBusy,
														Converter={StaticResource BooleanToVisibilityConverter}}" />

				<TextBlock
					VerticalAlignment ="Center"
					Text              ="{Binding StatusMessage}"
					TextTrimming      ="CharacterEllipsis"
					ToolTip           ="{Binding StatusMessage}" />
			</DockPanel>
		</Border>
	</Grid>
</Window>