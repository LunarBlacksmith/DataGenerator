<UserControl
	x:Class              ="DataGenerator.Views.ColumnRulesPanel"
	xmlns                ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x              ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d              ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc             ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:models         ="clr-namespace:DataGenerator.Models"
	xmlns:viewModels     ="clr-namespace:DataGenerator.ViewModels"
	mc:Ignorable         ="d"
	d:DataContext        ="{d:DesignInstance Type=viewModels:DatabaseExplorerViewModel}">
	<UserControl.Resources>
		<!-- Lets the grid columns and the header menu, which are outside the visual tree, reach the column visibility choices -->
		<infrastructure:BindingProxy
			x:Key ="RuleGridColumnsProxy"
			Data  ="{Binding RuleGridColumns}" />

		<!-- Right-click a column header of the grid to hide or show the optional columns -->
		<ContextMenu
			x:Key       ="RuleGridColumnsMenu"
			ItemsSource ="{Binding	Data.Options,
											Source={StaticResource RuleGridColumnsProxy}}">
			<ContextMenu.ItemContainerStyle>
				<Style
					TargetType="MenuItem">
					<Setter
						Property ="Header"
						Value    ="{Binding DisplayName}" />
					<Setter
						Property ="ToolTip"
						Value    ="{Binding Description}" />
					<Setter
						Property ="IsCheckable"
						Value    ="True" />
					<Setter
						Property ="IsChecked"
						Value    ="{Binding	IsVisible,
												Mode=TwoWay}" />
					<Setter
						Property ="StaysOpenOnClick"
						Value    ="True" />
				</Style>
			</ContextMenu.ItemContainerStyle>
		</ContextMenu>

		<!-- Applies the optional-column context menu to every header in the rules grid -->
		<Style
			x:Key      ="RuleGridColumnHeaderStyle"
			TargetType ="DataGridColumnHeader"
			BasedOn    ="{StaticResource {x:Type DataGridColumnHeader}}">
			<Setter
				Property ="ContextMenu"
				Value    ="{StaticResource RuleGridColumnsMenu}" />
		</Style>

		<!-- Shared heading text used at the top of the set, lookup and saved-settings pop-ups -->
		<Style
			x:Key      ="PopupHeaderTextStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Setter
				Property ="Margin"
				Value    ="8,6,8,2" />
			<Setter
				Property ="FontWeight"
				Value    ="SemiBold" />
			<Setter
				Property ="TextTrimming"
				Value    ="CharacterEllipsis" />
		</Style>

		<!-- Compact text editor used by settings cells where the current generation mode accepts typed input -->
		<Style
			x:Key      ="CellTextBoxStyle"
			TargetType ="TextBox"
			BasedOn    ="{StaticResource {x:Type TextBox}}">
			<Setter
				Property ="Margin"
				Value    ="0,2" />
		</Style>

		<!-- Code-style settings editor for expressions, regexes, patterns and lookup formulas -->
		<Style
			x:Key      ="CellCodeTextBoxStyle"
			TargetType ="TextBox"
			BasedOn    ="{StaticResource CellTextBoxStyle}">
			<Setter
				Property ="FontFamily"
				Value    ="{StaticResource CodeFontFamily}" />
			<Setter
				Property ="TextWrapping"
				Value    ="Wrap" />
		</Style>

		<!-- Compact combo box used inside grid cells, so mode-specific choices align with text editors -->
		<Style
			x:Key      ="CellComboBoxStyle"
			TargetType ="ComboBox"
			BasedOn    ="{StaticResource {x:Type ComboBox}}">
			<Setter
				Property ="Margin"
				Value    ="0,2" />
		</Style>

		<!-- Secondary line under the column name; hidden when the column is not a foreign-key reference -->
		<Style
			x:Key      ="ReferenceTextStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Setter
				Property ="FontSize"
				Value    ="11" />
			<Setter
				Property ="TextTrimming"
				Value    ="CharacterEllipsis" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding ReferenceDisplay}"
					Value   ="">
					<Setter
						Property ="Visibility"
						Value    ="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- Sample values use the code font and switch to the error brush when the preview is a validation problem -->
		<Style
			x:Key      ="SampleTextStyle"
			TargetType ="TextBlock">
			<Setter
				Property ="VerticalAlignment"
				Value    ="Center" />
			<Setter
				Property ="FontFamily"
				Value    ="{StaticResource CodeFontFamily}" />
			<Setter
				Property ="FontSize"
				Value    ="12" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding PreviewIsError}"
					Value   ="True">
					<Setter
						Property ="Foreground"
						Value    ="{DynamicResource ErrorBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- A slim scroll bar, so a long sample makes its row only slightly taller -->
		<Style
			x:Key      ="SampleScrollViewerStyle"
			TargetType ="ScrollViewer">
			<Style.Resources>
				<Style
					TargetType ="ScrollBar"
					BasedOn    ="{StaticResource {x:Type ScrollBar}}">
					<Style.Triggers>
						<Trigger
							Property ="Orientation"
							Value    ="Horizontal">
							<Setter
								Property ="Height"
								Value    ="12" />
							<Setter
								Property ="MinHeight"
								Value    ="12" />
							<Setter
								Property ="Background"
								Value    ="Transparent" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</Style.Resources>

			<Setter
				Property ="Focusable"
				Value    ="False" />
			<Setter
				Property ="HorizontalScrollBarVisibility"
				Value    ="Auto" />
			<Setter
				Property ="VerticalScrollBarVisibility"
				Value    ="Disabled" />
		</Style>

		<!-- Watermark over the regex preset combo until the current pattern matches one of the saved profiles -->
		<Style
			x:Key      ="PresetWatermarkStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Setter
				Property ="Visibility"
				Value    ="Collapsed" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding SelectedRegexProfile}"
					Value   ="{x:Null}">
					<Setter
						Property ="Visibility"
						Value    ="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- Editors of the generation modes; a column only shows the editor of its own mode. Two-way bindings set UpdateSourceTrigger=PropertyChanged (see the grid below) -->
		<!-- Fixed value: one typed value is reused for every generated row, filtered to the column's SQL type -->
		<DataTemplate
			x:Key    ="FixedSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid
				Background ="Transparent"
				ToolTip    ="{Binding FixedValueHint}">
				<TextBox
					Style ="{StaticResource CellTextBoxStyle}"
					Text  ="{Binding	FixedValue,
											Mode=TwoWay,
											UpdateSourceTrigger=PropertyChanged}"
					infrastructure:TextInputFilter.Kind ="{Binding FixedValueInputKind}" />
			</Grid>
		</DataTemplate>

		<!-- Sequence: start and step are typed separately and constrained to integer or decimal input as needed -->
		<DataTemplate
			x:Key    ="SequenceSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column ="0"
					Margin      ="0,0,4,0"
					Style       ="{StaticResource SecondaryTextStyle}"
					Text        ="Start" />

				<Grid
					Grid.Column ="1"
					Background  ="Transparent"
					ToolTip     ="{StaticResource SequenceStartHint}">
					<TextBox
						Style                      ="{StaticResource CellTextBoxStyle}"
						HorizontalContentAlignment ="Right"
						Text                       ="{Binding	SequenceStartText,
																			Mode=TwoWay,
																			UpdateSourceTrigger=PropertyChanged}"
						infrastructure:TextInputFilter.Kind ="{Binding SequenceInputKind}" />
				</Grid>

				<TextBlock
					Grid.Column ="2"
					Margin      ="10,0,4,0"
					Style       ="{StaticResource SecondaryTextStyle}"
					Text        ="Step" />

				<Grid
					Grid.Column ="3"
					Background  ="Transparent"
					ToolTip     ="{StaticResource SequenceStepHint}">
					<TextBox
						Style                      ="{StaticResource CellTextBoxStyle}"
						HorizontalContentAlignment ="Right"
						Text                       ="{Binding	SequenceStepText,
																			Mode=TwoWay,
																			UpdateSourceTrigger=PropertyChanged}"
						infrastructure:TextInputFilter.Kind ="{Binding SequenceInputKind}" />
				</Grid>
			</Grid>
		</DataTemplate>

		<!-- Regex: free-form pattern plus optional preset list, with the placeholder shown when no preset matches -->
		<DataTemplate
			x:Key    ="RegexSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Column ="0"
					Background  ="Transparent"
					ToolTip     ="{StaticResource RegexHint}">
					<TextBox
						Style ="{StaticResource CellCodeTextBoxStyle}"
						Text  ="{Binding	RegexPattern,
												Mode=TwoWay,
												UpdateSourceTrigger=PropertyChanged}" />
				</Grid>

				<Grid
					Grid.Column ="1"
					Width       ="110"
					Margin      ="4,0,0,0">
					<ComboBox
						Style             ="{StaticResource CellComboBoxStyle}"
						DisplayMemberPath ="Name"
						ItemsSource       ="{Binding RegexProfiles}"
						SelectedItem      ="{Binding	SelectedRegexProfile,
																Mode=TwoWay,
																UpdateSourceTrigger=PropertyChanged}"
						ToolTip           ="{StaticResource RegexPresetHint}" />

					<TextBlock
						Margin           ="7,0,24,0"
						Style            ="{StaticResource PresetWatermarkStyle}"
						FontStyle        ="Italic"
						IsHitTestVisible ="False"
						Text             ="Presets" />
				</Grid>
			</Grid>
		</DataTemplate>

		<!-- Pattern: expression editor wired to pattern auto-completion and the pattern-language help button -->
		<DataTemplate
			x:Key    ="PatternSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Column ="0"
					Background  ="Transparent"
					ToolTip     ="{StaticResource PatternHint}">
					<TextBox
						Style ="{StaticResource CellCodeTextBoxStyle}"
						Text  ="{Binding	PatternExpression,
												Mode=TwoWay,
												UpdateSourceTrigger=PropertyChanged}"
						infrastructure:PatternAutoComplete.Provider ="{StaticResource PatternCompletionProvider}" />
				</Grid>

				<Button
					Grid.Column      ="1"
					Margin           ="4,0,0,0"
					Style            ="{StaticResource IconButtonStyle}"
					Command          ="{Binding	DataContext.ShowPatternHelpCommand,
															RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter ="{Binding	PatternExpression,
															ValidatesOnNotifyDataErrors=False}"
					ToolTip          ="{StaticResource PatternHelpHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE897;" />
			</Grid>
		</DataTemplate>

		<!-- Copy of column: choose another column in the same row set as the source value -->
		<DataTemplate
			x:Key    ="CopyColumnSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock
					Grid.Column ="0"
					Margin      ="0,0,4,0"
					Style       ="{StaticResource SecondaryTextStyle}"
					Text        ="Copy" />

				<ComboBox
					Grid.Column  ="1"
					Style        ="{StaticResource CellComboBoxStyle}"
					ItemsSource  ="{Binding CopySourceOptions}"
					SelectedItem ="{Binding	SourceColumnName,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}"
					ToolTip      ="{StaticResource CopyColumnHint}" />
			</Grid>
		</DataTemplate>

		<!-- Value from table: the expression can be typed, or built from lists in the pop-up that ▾ opens -->
		<DataTemplate
			x:Key    ="TableLookupSettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Column ="0"
					Background  ="Transparent"
					ToolTip     ="{StaticResource TableLookupHint}">
					<TextBox
						Style ="{StaticResource CellCodeTextBoxStyle}"
						Text  ="{Binding	LookupExpression,
												Mode=TwoWay,
												UpdateSourceTrigger=PropertyChanged}" />
				</Grid>

				<ToggleButton
					x:Name      ="LookupBuilderButton"
					Grid.Column ="1"
					Margin      ="4,0,0,0"
					IsChecked   ="{Binding	IsLookupBuilderOpen,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}"
					ToolTip     ="{StaticResource LookupBuilderButtonHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE70D;">
					<ToggleButton.Style>
						<Style
							TargetType ="ToggleButton"
							BasedOn    ="{StaticResource IconToggleButtonStyle}">
							<Style.Triggers>
								<!-- While the pop-up is open a click on the button only closes it (instead of closing and reopening it) -->
								<DataTrigger
									Binding ="{Binding IsLookupBuilderOpen}"
									Value   ="True">
									<Setter
										Property ="IsHitTestVisible"
										Value    ="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ToggleButton.Style>
				</ToggleButton>

				<!-- Lookup builder pop-up works on a temporary LookupBuilderViewModel until Apply copies the expression back -->
				<Popup
					AllowsTransparency ="True"
					IsOpen             ="{Binding	IsLookupBuilderOpen,
															Mode=TwoWay,
															UpdateSourceTrigger=PropertyChanged}"
					Placement          ="Bottom"
					PlacementTarget    ="{Binding ElementName=LookupBuilderButton}"
					PopupAnimation     ="Fade"
					StaysOpen          ="False">
					<Border
						x:Name ="LookupBuilderBorder"
						Style  ="{StaticResource PopupMenuBorderStyle}">
						<!-- Lists source table, source column, row scope and optional filter for the lookup expression -->
						<Grid
							Width       ="400"
							Margin      ="0,0,0,6"
							DataContext ="{Binding LookupBuilder}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="Auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
								<RowDefinition
									Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row        ="0"
								Grid.ColumnSpan ="2"
								Style           ="{StaticResource PopupHeaderTextStyle}"
								Text            ="{Binding	DataContext.Name,
																	ElementName=LookupBuilderBorder,
																	StringFormat='Value from table · {0}'}" />

							<Label
								Grid.Row    ="1"
								Grid.Column ="0"
								Margin      ="4,2"
								Content     ="Table:"
								ToolTip     ="{StaticResource LookupTableHint}" />

							<ComboBox
								Grid.Row     ="1"
								Grid.Column  ="1"
								Margin       ="4,2,8,2"
								ItemsSource  ="{Binding Tables}"
								SelectedItem ="{Binding	SelectedTableOption,
																Mode=TwoWay,
																UpdateSourceTrigger=PropertyChanged}"
								ToolTip      ="{StaticResource LookupTableHint}" />

							<Label
								Grid.Row    ="2"
								Grid.Column ="0"
								Margin      ="4,2"
								Content     ="Column:"
								ToolTip     ="{StaticResource LookupColumnHint}" />

							<ComboBox
								Grid.Row          ="2"
								Grid.Column       ="1"
								Margin            ="4,2,8,2"
								DisplayMemberPath ="Name"
								ItemsSource       ="{Binding Columns}"
								SelectedItem      ="{Binding	SelectedColumn,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}"
								ToolTip           ="{StaticResource LookupColumnHint}" />

							<Label
								Grid.Row    ="3"
								Grid.Column ="0"
								Margin      ="4,2"
								Content     ="Rows:"
								ToolTip     ="{StaticResource LookupScopeHint}" />

							<ComboBox
								Grid.Row          ="3"
								Grid.Column       ="1"
								Margin            ="4,2,8,2"
								DisplayMemberPath ="DisplayName"
								ItemsSource       ="{Binding ScopeOptions}"
								SelectedItem      ="{Binding	SelectedScope,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}"
								ToolTip           ="{Binding SelectedScope.Description}" />

							<CheckBox
								Grid.Row    ="4"
								Grid.Column ="1"
								Margin      ="4,4,8,2"
								Content     ="Unique (each value is used at most once)"
								IsChecked   ="{Binding	IsUnique,
																Mode=TwoWay,
																UpdateSourceTrigger=PropertyChanged}"
								ToolTip     ="{StaticResource LookupUniqueHint}" />

							<Label
								Grid.Row    ="5"
								Grid.Column ="0"
								Margin      ="4,2"
								Content     ="Filter:"
								ToolTip     ="{StaticResource LookupFilterHint}" />

							<ComboBox
								Grid.Row          ="5"
								Grid.Column       ="1"
								Margin            ="4,2,8,2"
								DisplayMemberPath ="DisplayName"
								ItemsSource       ="{Binding FilterOptions}"
								SelectedItem      ="{Binding	SelectedFilter,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}"
								ToolTip           ="{Binding SelectedFilter.Description}" />

							<!-- Filter text is only visible for pattern, regex or SQL filters; no-filter lookups skip this row -->
							<Grid
								Grid.Row    ="6"
								Grid.Column ="1"
								Margin      ="4,2,8,2"
								Background  ="Transparent"
								ToolTip     ="{Binding SelectedFilter.Description}"
								Visibility  ="{Binding	HasFilter,
																Converter={StaticResource BooleanToVisibilityConverter}}">
								<StackPanel>
									<TextBox
										FontFamily ="{StaticResource CodeFontFamily}"
										Text       ="{Binding	FilterText,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}" />

									<!-- What to type for the chosen filter, e.g. that s is the source table -->
									<TextBlock
										MaxWidth            ="360"
										Margin              ="2,2,0,0"
										HorizontalAlignment ="Left"
										Style               ="{StaticResource SecondaryTextStyle}"
										FontSize            ="11"
										Text                ="{Binding SelectedFilter.Description}"
										TextWrapping        ="Wrap" />
								</StackPanel>
							</Grid>

							<!-- Live expression preview and validation error before it is applied to the column rule -->
							<StackPanel
								Grid.Row        ="7"
								Grid.ColumnSpan ="2"
								Margin          ="8,6,8,0">
								<TextBlock
									Style        ="{StaticResource SecondaryTextStyle}"
									FontFamily   ="{StaticResource CodeFontFamily}"
									Text         ="{Binding Expression}"
									TextWrapping ="Wrap"
									ToolTip      ="{StaticResource LookupExpressionPreviewHint}" />

								<TextBlock
									Margin       ="0,4,0,0"
									Foreground   ="{DynamicResource ErrorBrush}"
									Text         ="{Binding ErrorMessage}"
									TextWrapping ="Wrap"
									Visibility   ="{Binding	HasError,
																	Converter={StaticResource BooleanToVisibilityConverter}}" />
							</StackPanel>

							<Button
								Grid.Row            ="8"
								Grid.ColumnSpan     ="2"
								Margin              ="8,8,8,0"
								HorizontalAlignment ="Right"
								Command             ="{Binding	DataContext.ApplyLookupBuilderCommand,
																			ElementName=LookupBuilderBorder}"
								Content             ="Apply"
								IsDefault           ="True"
								ToolTip             ="{StaticResource LookupApplyHint}" />
						</Grid>
					</Border>
				</Popup>
			</Grid>
		</DataTemplate>

		<!-- Modes with no editable settings show a short description rather than an empty editor -->
		<DataTemplate
			x:Key    ="SummarySettingsTemplate"
			DataType ="{x:Type viewModels:ColumnRuleViewModel}">
			<TextBlock
				Style        ="{StaticResource SecondaryTextStyle}"
				FontStyle    ="Italic"
				Text         ="{Binding ModeSummary}"
				TextWrapping ="Wrap" />
		</DataTemplate>

		<!-- Chooses the correct settings template from the selected generation mode of the column rule -->
		<Style
			x:Key      ="SettingsEditorStyle"
			TargetType ="ContentControl">
			<Setter
				Property ="Focusable"
				Value    ="False" />
			<Setter
				Property ="IsTabStop"
				Value    ="False" />
			<Setter
				Property ="ContentTemplate"
				Value    ="{StaticResource SummarySettingsTemplate}" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.Fixed}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource FixedSettingsTemplate}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.Sequence}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource SequenceSettingsTemplate}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.Regex}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource RegexSettingsTemplate}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.Pattern}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource PatternSettingsTemplate}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.CopyColumn}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource CopyColumnSettingsTemplate}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding GenerationMode}"
					Value   ="{x:Static models:ValueGenerationMode.TableLookup}">
					<Setter
						Property ="ContentTemplate"
						Value    ="{StaticResource TableLookupSettingsTemplate}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- Generation-mode drop-down items carry their explanatory text as a tooltip -->
		<Style
			x:Key      ="ModeItemStyle"
			TargetType ="ComboBoxItem">
			<Setter
				Property ="ToolTip"
				Value    ="{Binding Description}" />
		</Style>

		<!-- Row-set tabs: insert and update sets share the same strip, with the selected tab accented -->
		<Style
			x:Key      ="RowSetTabStyle"
			TargetType ="TabItem">
			<Setter
				Property ="Padding"
				Value    ="10,4" />
			<Setter
				Property ="Foreground"
				Value    ="{DynamicResource SecondaryTextBrush}" />
			<Setter
				Property ="ToolTip"
				Value    ="{StaticResource RowSetTabHint}" />

			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate
						TargetType="TabItem">
						<Border
							x:Name          ="TabBorder"
							Margin          ="0,0,2,0"
							Background      ="{DynamicResource HeaderStripBrush}"
							BorderBrush     ="{DynamicResource SectionBorderBrush}"
							BorderThickness ="1,1,1,0"
							CornerRadius    ="4,4,0,0">
							<Border
								x:Name          ="AccentBorder"
								Padding         ="{TemplateBinding Padding}"
								BorderBrush     ="Transparent"
								BorderThickness ="0,2,0,0"
								CornerRadius    ="4,4,0,0">
								<ContentPresenter
									HorizontalAlignment ="Center"
									VerticalAlignment   ="Center"
									ContentSource       ="Header"
									RecognizesAccessKey ="True" />
							</Border>
						</Border>

						<ControlTemplate.Triggers>
							<Trigger
								Property ="IsMouseOver"
								Value    ="True">
								<Setter
									TargetName ="TabBorder"
									Property   ="Background"
									Value      ="{DynamicResource ButtonHoverBackgroundBrush}" />
							</Trigger>

							<Trigger
								Property ="IsSelected"
								Value    ="True">
								<Setter
									Property ="Panel.ZIndex"
									Value    ="1" />
								<Setter
									Property ="Foreground"
									Value    ="{DynamicResource TextBrush}" />
								<Setter
									TargetName ="TabBorder"
									Property   ="Margin"
									Value      ="0,0,2,-1" />
								<Setter
									TargetName ="TabBorder"
									Property   ="Background"
									Value      ="{DynamicResource RowBrush}" />
								<Setter
									TargetName ="AccentBorder"
									Property   ="BorderBrush"
									Value      ="{DynamicResource RulesAccentBrush}" />
							</Trigger>

							<Trigger
								Property ="IsEnabled"
								Value    ="False">
								<Setter
									Property ="Foreground"
									Value    ="{DynamicResource HiddenTextBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Opens the saved-settings menu of a column; highlighted while the column uses a saved setting -->
		<Style
			x:Key      ="SavedSettingsToggleStyle"
			TargetType ="ToggleButton"
			BasedOn    ="{StaticResource IconToggleButtonStyle}">
			<Setter
				Property ="Margin"
				Value    ="4,0,0,0" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding HasAppliedSetting}"
					Value   ="True">
					<Setter
						Property ="Foreground"
						Value    ="{DynamicResource AccentBrush}" />
				</DataTrigger>

				<DataTrigger
					Binding ="{Binding CanChangeMode}"
					Value   ="False">
					<Setter
						Property ="Visibility"
						Value    ="Collapsed" />
				</DataTrigger>

				<!-- While the menu is open a click on the button only closes the menu (instead of closing and reopening it) -->
				<DataTrigger
					Binding ="{Binding IsSavedSettingsMenuOpen}"
					Value   ="True">
					<Setter
						Property ="IsHitTestVisible"
						Value    ="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

	</UserControl.Resources>

	<!-- Selected-table column-rules panel: row-set tabs, update settings, bulk edit and the rules grid -->
	<GroupBox
		Header ="Column rules"
		Style  ="{StaticResource RulesSectionStyle}">
		<Grid>
			<!-- Empty-state message until DatabaseExplorerViewModel.ActiveTable is set by clicking a table -->
			<TextBlock
				Style      ="{StaticResource PlaceholderTextStyle}"
				Text       ="Click a table in the database explorer to choose how its columns are generated."
				Visibility ="{Binding	HasActiveTable,
												Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

			<Grid
				Visibility="{Binding	HasActiveTable,
											Converter={StaticResource BooleanToVisibilityConverter}}">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>

				<!-- Table being edited and its row sets -->
				<Grid
					Grid.Row ="0"
					Margin   ="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column       ="0"
						Margin            ="4,0,8,0"
						VerticalAlignment ="Center"
						FontSize          ="14"
						TextTrimming      ="CharacterEllipsis"
						ToolTip           ="{Binding ActiveTable.ToolTipText}">
						<Run
							Foreground ="{DynamicResource SecondaryTextBrush}"
							Text       ="{Binding	ActiveTable.Database.DisplayName,
															Mode=OneWay}" />

						<Run
							Foreground ="{DynamicResource SecondaryTextBrush}"
							Text       ="›" />

						<Run
							FontWeight ="SemiBold"
							Text       ="{Binding	ActiveTable.DisplayName,
															Mode=OneWay}" />
					</TextBlock>

					<!-- Includes or excludes the active table from generation without leaving the rules panel -->
					<CheckBox
						Grid.Column ="1"
						Content     ="Include in generation"
						IsChecked   ="{Binding	ActiveTable.IsIncluded,
														Mode=TwoWay}"
						ToolTip     ="{StaticResource IncludeActiveTableHint}" />

					<!-- Row-set toolbar: add insert sets, add update sets, duplicate the selected set or remove it -->
					<StackPanel
						Grid.Column ="2"
						Margin      ="8,0,0,0"
						Orientation ="Horizontal">
						<Button
							Style   ="{StaticResource ToolbarButtonStyle}"
							Command ="{Binding AddRowSetCommand}"
							Content ="_Add row set"
							ToolTip ="{StaticResource AddRowSetHint}"
							infrastructure:ButtonIcon.Glyph ="&#xE710;" />

						<Button
							Style   ="{StaticResource ToolbarButtonStyle}"
							Command ="{Binding AddUpdateSetCommand}"
							Content ="Add _update set"
							ToolTip ="{StaticResource AddUpdateSetHint}"
							infrastructure:ButtonIcon.Glyph ="&#xE70F;" />

						<Button
							Style   ="{StaticResource ToolbarButtonStyle}"
							Command ="{Binding DuplicateRowSetCommand}"
							Content ="_Duplicate"
							ToolTip ="{StaticResource DuplicateRowSetHint}"
							infrastructure:ButtonIcon.Glyph ="&#xE8C8;" />

						<Button
							Style   ="{StaticResource ToolbarButtonStyle}"
							Command ="{Binding RemoveRowSetCommand}"
							Content ="Re_move"
							ToolTip ="{StaticResource RemoveRowSetHint}"
							infrastructure:ButtonIcon.Glyph ="&#xE74D;" />
					</StackPanel>
				</Grid>

				<!-- One tab per row set of the active table; the selected tab supplies the RowSetViewModel below -->
				<TabControl
					Grid.Row           ="1"
					Padding            ="6,4,6,6"
					BorderBrush        ="{DynamicResource SectionBorderBrush}"
					ItemContainerStyle ="{StaticResource RowSetTabStyle}"
					ItemsSource        ="{Binding ActiveTable.RowSets}"
					SelectedItem       ="{Binding	ActiveTable.SelectedRowSet,
															Mode=TwoWay}">
					<TabControl.ItemTemplate>
						<!-- Tab header shows the row-set name, row count, step badge, update marker and validation warning -->
						<DataTemplate
							DataType="{x:Type viewModels:RowSetViewModel}">
							<StackPanel
								Orientation="Horizontal">
								<Border
									Margin     ="0,0,5,0"
									Style      ="{StaticResource BadgeStyle}"
									Background ="{DynamicResource RowSetBadgeBrush}"
									ToolTip    ="{StaticResource RowSetStepBadgeHint}"
									Visibility ="{Binding	IsLaterStep,
																	Converter={StaticResource BooleanToVisibilityConverter}}">
									<TextBlock
										Style      ="{StaticResource BadgeTextStyle}"
										Foreground ="{DynamicResource RowSetBadgeTextBrush}"
										Text       ="{Binding StepText}" />
								</Border>

								<TextBlock
									Margin            ="0,0,5,0"
									VerticalAlignment ="Center"
									FontFamily        ="Segoe MDL2 Assets"
									FontSize          ="11"
									Text              ="&#xE70F;"
									ToolTip           ="{StaticResource UpdateSetBadgeHint}"
									Visibility        ="{Binding	IsUpdate,
																			Converter={StaticResource BooleanToVisibilityConverter}}" />

								<TextBlock
									VerticalAlignment ="Center"
									Text              ="{Binding HeaderText}" />

								<TextBlock
									Margin     ="6,0,0,0"
									Style      ="{StaticResource WarningIconStyle}"
									FontSize   ="12"
									Visibility ="{Binding	IsValid,
																	Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
							</StackPanel>
						</DataTemplate>
					</TabControl.ItemTemplate>

					<TabControl.ContentTemplate>
						<!-- Row-set editor: common set fields first, then update-only options, bulk edit and column rules -->
						<DataTemplate
							DataType="{x:Type viewModels:RowSetViewModel}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="*" />
								</Grid.RowDefinitions>

								<!-- Row-set identity and toolbar: name, row count, step, set configuration and validation status -->
								<WrapPanel
									Grid.Row ="0"
									Margin   ="0,0,0,2">
									<Label
										Content ="_Name:"
										Target  ="{Binding ElementName=RowSetNameInput}"
										ToolTip ="{StaticResource RowSetNameHint}" />

									<Grid
										Background ="Transparent"
										ToolTip    ="{StaticResource RowSetNameHint}">
										<TextBox
											x:Name ="RowSetNameInput"
											Width  ="200"
											Text   ="{Binding	Name,
																	Mode=TwoWay,
																	UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<Label
										Margin  ="8,0,0,0"
										Content ="{Binding RowCountLabel}"
										Target  ="{Binding ElementName=RowSetRowCountInput}"
										ToolTip ="{StaticResource RowSetRowCountHint}" />

									<Grid
										Background ="Transparent"
										ToolTip    ="{StaticResource RowSetRowCountHint}">
										<TextBox
											x:Name                     ="RowSetRowCountInput"
											Width                      ="100"
											HorizontalContentAlignment ="Right"
											Text                       ="{Binding	RowCount,
																								Mode=TwoWay,
																								UpdateSourceTrigger=PropertyChanged}"
											infrastructure:TextInputFilter.Kind ="Integer" />
									</Grid>

									<Label
										Margin  ="8,0,0,0"
										Content ="S_tep:"
										Target  ="{Binding ElementName=RowSetStepInput}"
										ToolTip ="{StaticResource RowSetStepHint}" />

									<Grid
										Background ="Transparent"
										ToolTip    ="{StaticResource RowSetStepHint}">
										<TextBox
											x:Name                     ="RowSetStepInput"
											Width                      ="40"
											HorizontalContentAlignment ="Right"
											Text                       ="{Binding	Step,
																								Mode=TwoWay,
																								UpdateSourceTrigger=PropertyChanged}"
											infrastructure:TextInputFilter.Kind ="Integer" />
									</Grid>

									<!-- Saves or loads the settings of every column of this row set as one named configuration -->
									<Grid
										Margin      ="10,0,0,0"
										DataContext ="{Binding	DataContext.SetConfigurations,
																		RelativeSource={RelativeSource AncestorType=UserControl}}">
										<ToggleButton
											x:Name    ="SetConfigurationButton"
											Content   ="Set configuration"
											IsChecked ="{Binding	IsMenuOpen,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}"
											ToolTip   ="{StaticResource SetConfigurationButtonHint}"
											infrastructure:ButtonIcon.Glyph ="&#xE8F1;">
											<ToggleButton.Style>
												<Style
													TargetType ="ToggleButton"
													BasedOn    ="{StaticResource ToolbarToggleButtonStyle}">
													<Style.Triggers>
														<!-- While the menu is open a click on the button only closes it (instead of closing and reopening it) -->
														<DataTrigger
															Binding ="{Binding IsMenuOpen}"
															Value   ="True">
															<Setter
																Property ="IsHitTestVisible"
																Value    ="False" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</ToggleButton.Style>
										</ToggleButton>

										<!-- Set configuration pop-up saves or loads all configurable column settings for this row set -->
										<Popup
											AllowsTransparency ="True"
											IsOpen             ="{Binding	IsMenuOpen,
																					Mode=TwoWay,
																					UpdateSourceTrigger=PropertyChanged}"
											Placement          ="Bottom"
											PlacementTarget    ="{Binding ElementName=SetConfigurationButton}"
											PopupAnimation     ="Fade"
											StaysOpen          ="False">
											<Border
												Style ="{StaticResource PopupMenuBorderStyle}">
												<StackPanel
													Width ="360">
													<TextBlock
														Style ="{StaticResource PopupHeaderTextStyle}"
														Text  ="{Binding MenuTitle}" />

													<TextBlock
														Margin       ="8,0,8,6"
														Style        ="{StaticResource SecondaryTextStyle}"
														Text         ="Saves or loads the generation mode and settings of every column of this set at once. To reuse the settings of a single column, use the star button in its Settings cell instead."
														TextWrapping ="Wrap" />

													<DockPanel
														Margin ="8,2,8,2">
														<Label
															Padding           ="0,0,6,0"
															VerticalAlignment ="Center"
															Content           ="Save _as:"
															Target            ="{Binding ElementName=SetConfigurationNameInput}"
															ToolTip           ="{StaticResource SaveSetConfigurationHint}" />

														<Button
															DockPanel.Dock ="Right"
															Margin         ="6,0,0,0"
															Style          ="{StaticResource ToolbarButtonStyle}"
															Command        ="{Binding SaveCommand}"
															Content        ="Save"
															ToolTip        ="{StaticResource SaveSetConfigurationHint}"
															infrastructure:ButtonIcon.Glyph ="&#xE74E;" />

														<TextBox
															x:Name  ="SetConfigurationNameInput"
															Text    ="{Binding	NewName,
																						Mode=TwoWay,
																						UpdateSourceTrigger=PropertyChanged}"
															ToolTip ="{StaticResource SaveSetConfigurationHint}">
															<TextBox.InputBindings>
																<KeyBinding
																	Key     ="Enter"
																	Command ="{Binding SaveCommand}" />
															</TextBox.InputBindings>
														</TextBox>
													</DockPanel>

													<TextBlock
														Margin       ="8,0,8,2"
														Foreground   ="{DynamicResource ErrorBrush}"
														Text         ="{Binding NameError}"
														TextWrapping ="Wrap"
														Visibility   ="{Binding	HasNameError,
																						Converter={StaticResource BooleanToVisibilityConverter}}" />

													<Separator
														Margin ="4" />

													<!-- Load choices are saved configurations sharing at least one column with this table -->
													<TextBlock
														Style   ="{StaticResource PopupHeaderTextStyle}"
														Text    ="Load into this set"
														ToolTip ="{StaticResource LoadSetConfigurationHint}" />

													<TextBlock
														Margin       ="8,2,8,6"
														Style        ="{StaticResource SecondaryTextStyle}"
														Text         ="No saved set configuration has columns of this table yet. Save one above, or import a file someone shared."
														TextWrapping ="Wrap"
														Visibility   ="{Binding	HasOptions,
																						Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

													<ScrollViewer
														MaxHeight                     ="300"
														HorizontalScrollBarVisibility ="Disabled"
														VerticalScrollBarVisibility   ="Auto">
														<ItemsControl
															ItemsSource ="{Binding Options}">
															<ItemsControl.ItemTemplate>
																<DataTemplate
																	DataType="{x:Type viewModels:RowSetConfigurationOption}">
																	<Grid>
																		<Grid.ColumnDefinitions>
																			<ColumnDefinition
																				Width="*" />
																			<ColumnDefinition
																				Width="Auto" />
																		</Grid.ColumnDefinitions>

																		<Button
																			Grid.Column                ="0"
																			HorizontalContentAlignment ="Stretch"
																			Style                      ="{StaticResource PopupMenuButtonStyle}"
																			Command                    ="{Binding	DataContext.LoadCommand,
																																RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																			CommandParameter           ="{Binding}"
																			ToolTip                    ="{Binding ToolTipText}">
																			<StackPanel>
																				<StackPanel
																					Orientation ="Horizontal">
																					<TextBlock
																						MaxWidth     ="220"
																						FontWeight   ="SemiBold"
																						Text         ="{Binding Name}"
																						TextTrimming ="CharacterEllipsis" />

																					<TextBlock
																						Margin     ="6,0,0,0"
																						Style      ="{StaticResource SecondaryTextStyle}"
																						Text       ="· this table"
																						Visibility ="{Binding	IsFromActiveTable,
																														Converter={StaticResource BooleanToVisibilityConverter}}" />
																				</StackPanel>

																				<TextBlock
																					Style        ="{StaticResource SecondaryTextStyle}"
																					Text         ="{Binding Summary}"
																					TextTrimming ="CharacterEllipsis" />
																			</StackPanel>
																		</Button>

																		<Button
																			Grid.Column       ="1"
																			Margin            ="2,0,4,0"
																			VerticalAlignment ="Center"
																			Style             ="{StaticResource IconButtonStyle}"
																			Command           ="{Binding	DataContext.DeleteCommand,
																													RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																			CommandParameter  ="{Binding}"
																			ToolTip           ="{StaticResource DeleteSetConfigurationHint}"
																			infrastructure:ButtonIcon.Glyph ="&#xE74D;" />
																	</Grid>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</ScrollViewer>

													<TextBlock
														Margin       ="8,2,8,2"
														Style        ="{StaticResource SecondaryTextStyle}"
														Text         ="{Binding OtherTablesText}"
														TextWrapping ="Wrap"
														Visibility   ="{Binding	HasOtherTables,
																						Converter={StaticResource BooleanToVisibilityConverter}}" />

													<Separator
														Margin ="4" />

													<!-- Import and export operate on the whole saved set-configuration library -->
													<Button
														Style   ="{StaticResource PopupMenuButtonStyle}"
														Command ="{Binding ImportCommand}"
														Content ="Import set configurations…"
														ToolTip ="{StaticResource ImportSetConfigurationsHint}"
														infrastructure:ButtonIcon.Glyph ="&#xE8B5;" />

													<Button
														Style   ="{StaticResource PopupMenuButtonStyle}"
														Command ="{Binding ExportCommand}"
														Content ="Export all set configurations…"
														ToolTip ="{StaticResource ExportSetConfigurationsHint}"
														infrastructure:ButtonIcon.Glyph ="&#xEDE1;" />
												</StackPanel>
											</Border>
										</Popup>
									</Grid>

									<StackPanel
										Margin      ="10,0,0,0"
										Orientation ="Horizontal"
										Visibility  ="{Binding	HasInvalidRules,
																		Converter={StaticResource BooleanToVisibilityConverter}}">
										<TextBlock
											Margin ="0,0,5,0"
											Style  ="{StaticResource WarningIconStyle}" />

										<TextBlock
											VerticalAlignment ="Center"
											Foreground        ="{DynamicResource WarningBrush}"
											Text              ="{Binding ValidationSummary}" />
									</StackPanel>

									<!-- What happened when a set configuration was last saved or loaded -->
									<Border
										Margin       ="10,0,0,0"
										Padding      ="6,1,2,1"
										Background   ="{DynamicResource HeaderStripBrush}"
										CornerRadius ="4"
										ToolTip      ="{Binding ConfigurationResult.Details}"
										Visibility   ="{Binding	HasConfigurationResult,
																		Converter={StaticResource BooleanToVisibilityConverter}}">
										<StackPanel
											Orientation ="Horizontal">
											<TextBlock
												MaxWidth          ="560"
												VerticalAlignment ="Center"
												Text              ="{Binding ConfigurationResult.Text}"
												TextTrimming      ="CharacterEllipsis">
												<TextBlock.Style>
													<Style
														TargetType ="TextBlock">
														<Setter
															Property ="Foreground"
															Value    ="{DynamicResource TextBrush}" />
														<Style.Triggers>
															<DataTrigger
																Binding ="{Binding ConfigurationResult.IsWarning}"
																Value   ="True">
																<Setter
																	Property ="Foreground"
																	Value    ="{DynamicResource WarningBrush}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>

											<Button
												Margin  ="4,0,0,0"
												Style   ="{StaticResource IconButtonStyle}"
												Command ="{Binding DismissConfigurationResultCommand}"
												ToolTip ="{StaticResource DismissSetConfigurationResultHint}"
												infrastructure:ButtonIcon.Glyph ="&#xE711;" />
										</StackPanel>
									</Border>
								</WrapPanel>

								<!-- Update sets only: which existing rows are changed -->
								<Border
									Grid.Row     ="1"
									Margin       ="0,2,0,2"
									Padding      ="4,3"
									Background   ="{DynamicResource HeaderStripBrush}"
									CornerRadius ="4"
									Visibility   ="{Binding	IsUpdate,
																	Converter={StaticResource BooleanToVisibilityConverter}}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="Auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="Auto" />
										</Grid.ColumnDefinitions>

										<Grid.RowDefinitions>
											<RowDefinition
												Height="Auto" />
											<RowDefinition
												Height="Auto" />
											<RowDefinition
												Height="Auto" />
										</Grid.RowDefinitions>

										<Label
											Grid.Column ="0"
											Content     ="Change:"
											Target      ="{Binding ElementName=UpdateScopeInput}"
											ToolTip     ="{StaticResource UpdateScopeHint}" />

										<ComboBox
											x:Name            ="UpdateScopeInput"
											Grid.Column       ="1"
											Width             ="160"
											DisplayMemberPath ="DisplayName"
											ItemsSource       ="{Binding UpdateScopeOptions}"
											SelectedValue     ="{Binding	UpdateScope,
																					Mode=TwoWay,
																					UpdateSourceTrigger=PropertyChanged}"
											SelectedValuePath ="Value"
											ToolTip           ="{StaticResource UpdateScopeHint}" />

										<Label
											Grid.Column ="2"
											Margin      ="8,0,0,0"
											Content     ="_Where:"
											Target      ="{Binding ElementName=UpdateConditionInput}"
											ToolTip     ="{StaticResource UpdateConditionHint}" />

										<Grid
											Grid.Column ="3"
											Background  ="Transparent"
											ToolTip     ="{StaticResource UpdateConditionHint}">
											<TextBox
												x:Name     ="UpdateConditionInput"
												FontFamily ="{StaticResource CodeFontFamily}"
												Text       ="{Binding	UpdateCondition,
																				Mode=TwoWay,
																				UpdateSourceTrigger=PropertyChanged}" />

											<!-- Placeholder is shown only while the update Where condition is empty -->
											<TextBlock
												Margin            ="6,0"
												VerticalAlignment ="Center"
												FontStyle         ="Italic"
												IsHitTestVisible  ="False"
												Text              ="Optional, e.g. t.[Size] = 'XL' AND t.[ShirtParentID] IS NULL">
												<TextBlock.Style>
													<Style
														TargetType ="TextBlock"
														BasedOn    ="{StaticResource SecondaryTextStyle}">
														<Setter
															Property ="Visibility"
															Value    ="Collapsed" />

														<Style.Triggers>
															<DataTrigger
																Binding ="{Binding UpdateCondition}"
																Value   ="">
																<Setter
																	Property ="Visibility"
																	Value    ="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</Grid>

										<CheckBox
											Grid.Column ="4"
											Margin      ="10,0,4,0"
											Content     ="Fail if fewer rows match"
											IsChecked   ="{Binding	RequireAllRows,
																			Mode=TwoWay,
																			UpdateSourceTrigger=PropertyChanged}"
											ToolTip     ="{StaticResource RequireAllRowsHint}" />

										<!-- How to write the Where condition, always in view -->
										<TextBlock
											Grid.Row     ="1"
											Grid.Column  ="3"
											Margin       ="2,2,0,0"
											Style        ="{StaticResource SecondaryTextStyle}"
											FontSize     ="11"
											TextWrapping ="Wrap"
											ToolTip      ="{StaticResource UpdateConditionHint}">
											<Run
												FontFamily ="{StaticResource CodeFontFamily}"
												FontWeight ="SemiBold"
												Text       ="t" />
											<Run
												Text=" = this table (the rows being changed); write a column as " />
											<Run
												FontFamily ="{StaticResource CodeFontFamily}"
												Text       ="t.[ColumnName]" />
											<Run
												Text=". Hover for more examples." />
										</TextBlock>

										<!-- Validation warning for update sets that would not change any columns -->
										<StackPanel
											Grid.Row        ="2"
											Grid.ColumnSpan ="5"
											Margin          ="4,3,0,0"
											Orientation     ="Horizontal"
											Visibility      ="{Binding	HasUpdateProblem,
																					Converter={StaticResource BooleanToVisibilityConverter}}">
											<TextBlock
												Margin ="0,0,5,0"
												Style  ="{StaticResource WarningIconStyle}" />

											<TextBlock
												VerticalAlignment ="Center"
												Foreground        ="{DynamicResource WarningBrush}"
												Text              ="{Binding UpdateProblem}" />
										</StackPanel>
									</Grid>
								</Border>

								<!-- Changes several selected columns at once -->
								<Border
									Grid.Row     ="2"
									Margin       ="0,2,0,2"
									Padding      ="4,2"
									Background   ="{DynamicResource HeaderStripBrush}"
									CornerRadius ="4"
									DataContext  ="{Binding BulkEdit}">
									<StackPanel>
										<DockPanel
											MinHeight="32">
											<Button
												DockPanel.Dock ="Right"
												Style          ="{StaticResource ToolbarButtonStyle}"
												Command        ="{Binding ClearSelectionCommand}"
												Content        ="Clear"
												ToolTip        ="{StaticResource BulkClearSelectionHint}" />

											<Button
												DockPanel.Dock ="Right"
												Style          ="{StaticResource ToolbarButtonStyle}"
												Command        ="{Binding SelectAllCommand}"
												Content        ="Select all"
												ToolTip        ="{StaticResource BulkSelectAllHint}"
												infrastructure:ButtonIcon.Glyph ="&#xE8B3;" />

											<!-- Help text until enough grid rows are selected to activate the bulk editor -->
											<TextBlock
												Margin            ="4,0"
												VerticalAlignment ="Center"
												Style             ="{StaticResource SecondaryTextStyle}"
												Text              ="Tip: Ctrl+click or Shift+click rows (or Select all) to change the mode or settings of several columns at once."
												TextTrimming      ="CharacterEllipsis"
												ToolTip           ="{StaticResource BulkSelectionHint}"
												Visibility        ="{Binding	IsActive,
																						Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

											<!-- Bulk editor appears for multi-selection and applies a mode or setting value to selected rules -->
											<WrapPanel
												Visibility="{Binding	IsActive,
																			Converter={StaticResource BooleanToVisibilityConverter}}">
												<TextBlock
													Margin            ="4,0,10,0"
													VerticalAlignment ="Center"
													FontWeight        ="SemiBold"
													Text              ="{Binding SelectionText}"
													ToolTip           ="{StaticResource BulkSelectionHint}" />

												<StackPanel
													Margin      ="0,0,10,0"
													Orientation ="Horizontal">
													<TextBlock
														Margin            ="0,0,2,0"
														VerticalAlignment ="Center"
														Text              ="Mode:" />

													<ComboBox
														Width             ="190"
														DisplayMemberPath ="DisplayName"
														ItemsSource       ="{Binding ModeOptions}"
														SelectedItem      ="{Binding	SelectedModeOption,
																								Mode=TwoWay}"
														ToolTip           ="{StaticResource BulkModeHint}">
														<ComboBox.ItemContainerStyle>
															<Style
																TargetType ="ComboBoxItem"
																BasedOn    ="{StaticResource {x:Type ComboBoxItem}}">
																<Setter
																	Property ="ToolTip"
																	Value    ="{Binding Description}" />
															</Style>
														</ComboBox.ItemContainerStyle>
													</ComboBox>

													<Button
														Style   ="{StaticResource ToolbarButtonStyle}"
														Command ="{Binding ApplyModeCommand}"
														Content ="Set mode"
														ToolTip ="{StaticResource BulkApplyModeHint}"
														infrastructure:ButtonIcon.Glyph ="&#xE73E;" />
												</StackPanel>

												<StackPanel
													Orientation="Horizontal">
													<TextBlock
														Margin            ="0,0,2,0"
														VerticalAlignment ="Center"
														Text              ="Settings:" />

													<Grid
														ToolTip="{StaticResource BulkSettingValueHint}">
														<TextBox
															Width      ="220"
															FontFamily ="{StaticResource CodeFontFamily}"
															Text       ="{Binding	SettingValue,
																							Mode=TwoWay,
																							UpdateSourceTrigger=PropertyChanged}">
															<TextBox.InputBindings>
																<KeyBinding
																	Key     ="Enter"
																	Command ="{Binding ApplySettingValueCommand}" />
															</TextBox.InputBindings>
														</TextBox>
													</Grid>

													<Button
														Style   ="{StaticResource ToolbarButtonStyle}"
														Command ="{Binding ApplySettingValueCommand}"
														Content ="Set value"
														ToolTip ="{StaticResource BulkApplySettingValueHint}"
														infrastructure:ButtonIcon.Glyph ="&#xE73E;" />
												</StackPanel>
											</WrapPanel>
										</DockPanel>

										<!-- Outcome of the latest bulk action, with skipped-column details in the tooltip -->
										<TextBlock
											Margin       ="4,0,4,3"
											Text         ="{Binding ResultText}"
											TextWrapping ="Wrap"
											ToolTip      ="{Binding ResultDetails}">
											<TextBlock.Style>
												<Style
													TargetType ="TextBlock"
													BasedOn    ="{StaticResource SecondaryTextStyle}">
													<Style.Triggers>
														<DataTrigger
															Binding ="{Binding HasResult}"
															Value   ="False">
															<Setter
																Property ="Visibility"
																Value    ="Collapsed" />
														</DataTrigger>

														<DataTrigger
															Binding ="{Binding ResultHasSkips}"
															Value   ="True">
															<Setter
																Property ="Foreground"
																Value    ="{DynamicResource WarningBrush}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</StackPanel>
								</Border>

								<!-- The row set's own problems (e.g. an update set that changes nothing) are shown above the grid, so the grid draws no red error border -->
								<!-- Each grid row has a BindingGroup that makes bindings without an explicit UpdateSourceTrigger wait for a row commit, so every editor in the cells sets UpdateSourceTrigger=PropertyChanged -->
								<DataGrid
									Grid.Row          ="3"
									Margin            ="0,2,0,0"
									ColumnHeaderStyle ="{StaticResource RuleGridColumnHeaderStyle}"
									ItemsSource       ="{Binding ColumnRules}"
									RowStyle          ="{StaticResource ColumnRuleRowStyle}"
									SelectionMode     ="Extended"
									ToolTip           ="{StaticResource ColumnRulesGridHint}"
									Validation.ErrorTemplate ="{x:Null}"
									infrastructure:GridCellNavigation.IsEnabled ="True"
									infrastructure:MultiSelection.SelectedItems ="{Binding BulkEdit.SelectedRules}">
									<DataGrid.Columns>
										<!-- Optional Keys column: badges for primary key, foreign key, naming-convention FTK and identity -->
										<DataGridTemplateColumn
											Width      ="68"
											MinWidth   ="68"
											Visibility ="{Binding	Data.Keys.IsVisible,
																			Source={StaticResource RuleGridColumnsProxy},
																			Converter={StaticResource BooleanToVisibilityConverter}}">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Keys"
													ToolTip ="{StaticResource KeyColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<StackPanel
														Background  ="Transparent"
														Orientation ="Horizontal"
														ToolTip     ="{StaticResource KeyColumnHint}">
														<Border
															Style      ="{StaticResource BadgeStyle}"
															Background ="{DynamicResource PrimaryKeyBadgeBrush}"
															Visibility ="{Binding	IsPrimaryKey,
																							Converter={StaticResource BooleanToVisibilityConverter}}">
															<TextBlock
																Style      ="{StaticResource BadgeTextStyle}"
																Foreground ="{DynamicResource PrimaryKeyBadgeTextBrush}"
																Text       ="PK" />
														</Border>

														<Border
															Style      ="{StaticResource BadgeStyle}"
															Background ="{DynamicResource ForeignKeyBadgeBrush}"
															Visibility ="{Binding	IsForeignKey,
																							Converter={StaticResource BooleanToVisibilityConverter}}">
															<TextBlock
																Style      ="{StaticResource BadgeTextStyle}"
																Foreground ="{DynamicResource ForeignKeyBadgeTextBrush}"
																Text       ="FK" />
														</Border>

														<Border
															Style           ="{StaticResource BadgeStyle}"
															Background      ="{DynamicResource ForeignTableKeyBadgeBrush}"
															BorderBrush     ="{DynamicResource ForeignTableKeyBadgeBorderBrush}"
															BorderThickness ="1"
															Visibility      ="{Binding	ShowForeignTableKeyBadge,
																								Converter={StaticResource BooleanToVisibilityConverter}}">
															<TextBlock
																Style      ="{StaticResource BadgeTextStyle}"
																Foreground ="{DynamicResource ForeignKeyBadgeTextBrush}"
																Text       ="FTK" />
														</Border>

														<Border
															Style      ="{StaticResource BadgeStyle}"
															Background ="{DynamicResource IdentityBadgeBrush}"
															Visibility ="{Binding	IsIdentity,
																							Converter={StaticResource BooleanToVisibilityConverter}}">
															<TextBlock
																Style      ="{StaticResource BadgeTextStyle}"
																Foreground ="{DynamicResource IdentityBadgeTextBrush}"
																Text       ="ID" />
														</Border>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Column column: database column name plus referenced table display when this is a key relationship -->
										<DataGridTemplateColumn
											Width    ="*"
											MinWidth ="110">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Column"
													ToolTip ="{StaticResource ColumnNameColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<StackPanel
														VerticalAlignment ="Center"
														Background        ="Transparent"
														ToolTip           ="{Binding ColumnDescription}">
														<TextBlock
															FontWeight   ="SemiBold"
															Text         ="{Binding Name}"
															TextTrimming ="CharacterEllipsis" />

														<TextBlock
															Style="{StaticResource ReferenceTextStyle}">
															<Run
																Text="→" />

															<Run
																Text="{Binding	ReferenceDisplay,
																					Mode=OneWay}" />
														</TextBlock>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Optional SQL type column: read-only display of the converter's SQL Server type text -->
										<DataGridTemplateColumn
											Width      ="Auto"
											MinWidth   ="90"
											Visibility ="{Binding	Data.SqlType.IsVisible,
																			Source={StaticResource RuleGridColumnsProxy},
																			Converter={StaticResource BooleanToVisibilityConverter}}">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="SQL type"
													ToolTip ="{StaticResource SqlTypeColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<TextBlock
														VerticalAlignment ="Center"
														FontFamily        ="{StaticResource CodeFontFamily}"
														FontSize          ="12"
														Text              ="{Binding SqlTypeDisplay}" />
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Optional Nullable column: shows whether the database column accepts NULL -->
										<DataGridTemplateColumn
											Width      ="70"
											MinWidth   ="70"
											Visibility ="{Binding	Data.Nullable.IsVisible,
																			Source={StaticResource RuleGridColumnsProxy},
																			Converter={StaticResource BooleanToVisibilityConverter}}">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Nullable"
													ToolTip ="{StaticResource NullableColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<TextBlock
														HorizontalAlignment ="Center"
														VerticalAlignment   ="Center"
														Text                ="{Binding NullableText}" />
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Generation mode column: limits choices to modes the column type and key role can use -->
										<DataGridTemplateColumn
											Width    ="158"
											MinWidth ="158">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Generation mode"
													ToolTip ="{StaticResource ModeColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<ComboBox
														Style              ="{StaticResource CellComboBoxStyle}"
														DisplayMemberPath  ="DisplayName"
														IsEnabled          ="{Binding CanChangeMode}"
														ItemContainerStyle ="{StaticResource ModeItemStyle}"
														ItemsSource        ="{Binding AvailableModes}"
														SelectedValue      ="{Binding	GenerationMode,
																								Mode=TwoWay,
																								UpdateSourceTrigger=PropertyChanged}"
														SelectedValuePath  ="Mode"
														ToolTip            ="{Binding SelectedModeOption.Description}" />
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Settings column: mode-specific editor plus the per-column saved-settings menu -->
										<DataGridTemplateColumn
											Width    ="2.4*"
											MinWidth ="180">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Settings"
													ToolTip ="{StaticResource SettingsColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition
																Width="*" />
															<ColumnDefinition
																Width="Auto" />
														</Grid.ColumnDefinitions>

														<ContentControl
															Grid.Column ="0"
															Style       ="{StaticResource SettingsEditorStyle}"
															Content     ="{Binding}" />

														<ToggleButton
															x:Name      ="SavedSettingsButton"
															Grid.Column ="1"
															Style       ="{StaticResource SavedSettingsToggleStyle}"
															IsChecked   ="{Binding	IsSavedSettingsMenuOpen,
																							Mode=TwoWay,
																							UpdateSourceTrigger=PropertyChanged}"
															ToolTip     ="{Binding SavedSettingsButtonHint}"
															infrastructure:ButtonIcon.Glyph ="&#xE728;" />

														<!-- Per-column saved-settings pop-up saves this rule or applies reusable settings that suit it -->
														<Popup
															AllowsTransparency ="True"
															IsOpen             ="{Binding	IsSavedSettingsMenuOpen,
																									Mode=TwoWay,
																									UpdateSourceTrigger=PropertyChanged}"
															Placement          ="Bottom"
															PlacementTarget    ="{Binding ElementName=SavedSettingsButton}"
															PopupAnimation     ="Fade"
															StaysOpen          ="False">
															<Border
																Style ="{StaticResource PopupMenuBorderStyle}">
																<StackPanel
																	Width ="320">
																	<TextBlock
																		Style ="{StaticResource PopupHeaderTextStyle}"
																		Text  ="{Binding	Name,
																								StringFormat='Saved settings · {0}'}" />

																	<Button
																		Style   ="{StaticResource PopupMenuButtonStyle}"
																		Command ="{Binding SaveSettingsCommand}"
																		Content ="Save these settings…"
																		ToolTip ="{StaticResource SaveSettingsHint}"
																		infrastructure:ButtonIcon.Glyph ="&#xE74E;" />

																	<Separator
																		Margin ="4" />

																	<TextBlock
																		Style ="{StaticResource PopupHeaderTextStyle}"
																		Text  ="Apply a saved setting" />

																	<TextBlock
																		Margin       ="8,2,8,6"
																		Style        ="{StaticResource SecondaryTextStyle}"
																		Text         ="No saved setting suits this column yet. Save the settings of a column to reuse them here."
																		TextWrapping ="Wrap"
																		Visibility   ="{Binding	HasSavedSettingOptions,
																										Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

																	<ScrollViewer
																		MaxHeight                     ="280"
																		HorizontalScrollBarVisibility ="Disabled"
																		VerticalScrollBarVisibility   ="Auto">
																		<ItemsControl
																			ItemsSource ="{Binding SavedSettingOptions}"
																			ToolTip     ="{StaticResource ApplySavedSettingHint}">
																			<ItemsControl.ItemTemplate>
																				<DataTemplate
																					DataType="{x:Type viewModels:SavedSettingOption}">
																					<Button
																						HorizontalAlignment ="Stretch"
																						Style               ="{StaticResource PopupMenuButtonStyle}"
																						Command             ="{Binding	DataContext.ApplySavedSettingCommand,
																																	RelativeSource={RelativeSource AncestorType=ItemsControl}}"
																						CommandParameter    ="{Binding}"
																						ToolTip             ="{Binding ToolTipText}">
																						<StackPanel>
																							<StackPanel
																								Orientation ="Horizontal">
																								<TextBlock
																									FontWeight   ="SemiBold"
																									Text         ="{Binding Name}"
																									TextTrimming ="CharacterEllipsis" />

																								<TextBlock
																									Margin     ="6,0,0,0"
																									Style      ="{StaticResource SecondaryTextStyle}"
																									Text       ="· saved for this column"
																									Visibility ="{Binding	IsSavedForColumn,
																																	Converter={StaticResource BooleanToVisibilityConverter}}" />
																							</StackPanel>

																							<TextBlock
																								MaxWidth     ="290"
																								Style        ="{StaticResource SecondaryTextStyle}"
																								FontFamily   ="{StaticResource CodeFontFamily}"
																								Text         ="{Binding Summary}"
																								TextTrimming ="CharacterEllipsis" />
																						</StackPanel>
																					</Button>
																				</DataTemplate>
																			</ItemsControl.ItemTemplate>
																		</ItemsControl>
																	</ScrollViewer>

																	<Separator
																		Margin ="4" />

																	<Button
																		Style   ="{StaticResource PopupMenuButtonStyle}"
																		Command ="{Binding ManageSavedSettingsCommand}"
																		Content ="Manage saved settings…"
																		ToolTip ="{StaticResource ManageSavedSettingsHint}"
																		infrastructure:ButtonIcon.Glyph ="&#xE713;" />
																</StackPanel>
															</Border>
														</Popup>
													</Grid>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<!-- Optional Sample values column: lazy preview text, or the validation problem when generation fails -->
										<DataGridTemplateColumn
											Width      ="1.2*"
											MinWidth   ="100"
											Visibility ="{Binding	Data.SampleValues.IsVisible,
																			Source={StaticResource RuleGridColumnsProxy},
																			Converter={StaticResource BooleanToVisibilityConverter}}">
											<DataGridTemplateColumn.Header>
												<TextBlock
													Text    ="Sample values"
													ToolTip ="{StaticResource SampleColumnHint}" />
											</DataGridTemplateColumn.Header>

											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate
													DataType="{x:Type viewModels:ColumnRuleViewModel}">
													<!-- Long samples scroll sideways (Shift + mouse wheel or the scroll bar); the plain wheel still scrolls the grid -->
													<ScrollViewer
														Style   ="{StaticResource SampleScrollViewerStyle}"
														ToolTip ="{Binding PreviewText}"
														infrastructure:HorizontalWheelScroll.IsEnabled ="True">
														<TextBlock
															Style ="{StaticResource SampleTextStyle}"
															Text  ="{Binding PreviewText}" />
													</ScrollViewer>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>
							</Grid>
						</DataTemplate>
					</TabControl.ContentTemplate>
				</TabControl>

				<!-- Legend of the row colours -->
				<DockPanel
					Grid.Row ="2"
					Margin   ="0,6,0,0">
					<Button
						DockPanel.Dock ="Right"
						Style          ="{StaticResource ToolbarButtonStyle}"
						Command        ="{Binding	DataContext.ShowPatternHelpCommand,
															RelativeSource={RelativeSource AncestorType=Window}}"
						Content        ="Pattern language"
						ToolTip        ="{StaticResource PatternLanguageHint}"
						infrastructure:ButtonIcon.Glyph ="&#xE897;" />

					<Button
						DockPanel.Dock ="Right"
						Style          ="{StaticResource ToolbarButtonStyle}"
						Command        ="{Binding ManageSavedSettingsCommand}"
						Content        ="Saved column settings"
						ToolTip        ="{StaticResource ManageSavedSettingsHint}"
						infrastructure:ButtonIcon.Glyph ="&#xE728;" />

					<!-- Opens the same optional-column choices as the grid header context menu and remembers them in preferences -->
					<ToggleButton
						x:Name         ="GridColumnsButton"
						DockPanel.Dock ="Right"
						Content        ="{Binding RuleGridColumns.HiddenColumnsText}"
						IsChecked      ="{Binding	RuleGridColumns.IsMenuOpen,
															Mode=TwoWay,
															UpdateSourceTrigger=PropertyChanged}"
						ToolTip        ="{StaticResource RuleGridColumnsHint}"
						infrastructure:ButtonIcon.Glyph ="&#xE8A9;">
						<ToggleButton.Style>
							<Style
								TargetType ="ToggleButton"
								BasedOn    ="{StaticResource ToolbarToggleButtonStyle}">
								<Style.Triggers>
									<!-- While the list is open a click on the button only closes the list (instead of closing and reopening it) -->
									<DataTrigger
										Binding ="{Binding RuleGridColumns.IsMenuOpen}"
										Value   ="True">
										<Setter
											Property ="IsHitTestVisible"
											Value    ="False" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ToggleButton.Style>
					</ToggleButton>

					<!-- Grid-columns pop-up: toggles optional columns and can restore every column at once -->
					<Popup
						AllowsTransparency ="True"
						IsOpen             ="{Binding	RuleGridColumns.IsMenuOpen,
																Mode=TwoWay,
																UpdateSourceTrigger=PropertyChanged}"
						Placement          ="Top"
						PlacementTarget    ="{Binding ElementName=GridColumnsButton}"
						PopupAnimation     ="Fade"
						StaysOpen          ="False">
						<Border
							Style ="{StaticResource PopupMenuBorderStyle}">
							<StackPanel
								Width ="260">
								<TextBlock
									Style ="{StaticResource PopupHeaderTextStyle}"
									Text  ="Columns shown in the grid" />

								<ItemsControl
									ItemsSource="{Binding RuleGridColumns.Options}">
									<ItemsControl.ItemTemplate>
										<DataTemplate
											DataType="{x:Type viewModels:RuleGridColumnOption}">
											<CheckBox
												Margin    ="8,3"
												Content   ="{Binding DisplayName}"
												IsChecked ="{Binding	IsVisible,
																			Mode=TwoWay,
																			UpdateSourceTrigger=PropertyChanged}"
												ToolTip   ="{Binding Description}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBlock
									Margin       ="8,4,8,4"
									Style        ="{StaticResource SecondaryTextStyle}"
									Text         ="Column, Generation mode and Settings are always shown. Right-clicking a column header gives the same choices."
									TextWrapping ="Wrap" />

								<Separator
									Margin ="4" />

								<Button
									Style   ="{StaticResource PopupMenuButtonStyle}"
									Command ="{Binding RuleGridColumns.ShowAllCommand}"
									Content ="Show all columns"
									ToolTip ="{StaticResource ShowAllRuleGridColumnsHint}"
									infrastructure:ButtonIcon.Glyph ="&#xE890;" />
							</StackPanel>
						</Border>
					</Popup>

					<!-- Colour legend mirrors the row badges and backgrounds used for key and identity columns -->
					<StackPanel
						Background  ="Transparent"
						Orientation ="Horizontal"
						ToolTip     ="{StaticResource KeyLegendHint}">
						<Border
							Width           ="14"
							Height          ="14"
							Margin          ="4,0,5,0"
							Background      ="{DynamicResource PrimaryKeyRowBrush}"
							BorderBrush     ="{DynamicResource PrimaryKeyBadgeBrush}"
							BorderThickness ="1"
							CornerRadius    ="3" />

						<TextBlock
							Style ="{StaticResource SecondaryTextStyle}"
							Text  ="Primary key" />

						<Border
							Width           ="14"
							Height          ="14"
							Margin          ="14,0,5,0"
							Background      ="{DynamicResource ForeignKeyRowBrush}"
							BorderBrush     ="{DynamicResource ForeignKeyBadgeBrush}"
							BorderThickness ="1"
							CornerRadius    ="3" />

						<TextBlock
							Style ="{StaticResource SecondaryTextStyle}"
							Text  ="Foreign key or FTK column" />

						<Border
							Margin     ="14,0,5,0"
							Style      ="{StaticResource BadgeStyle}"
							Background ="{DynamicResource IdentityBadgeBrush}">
							<TextBlock
								Style      ="{StaticResource BadgeTextStyle}"
								Foreground ="{DynamicResource IdentityBadgeTextBrush}"
								Text       ="ID" />
						</Border>

						<TextBlock
							Style ="{StaticResource SecondaryTextStyle}"
							Text  ="Identity" />
					</StackPanel>
				</DockPanel>
			</Grid>
		</Grid>
	</GroupBox>
</UserControl>