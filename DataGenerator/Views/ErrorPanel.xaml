<UserControl
	x:Class              ="DataGenerator.Views.ErrorPanel"
	xmlns                ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x              ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d              ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc             ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels     ="clr-namespace:DataGenerator.ViewModels"
	xmlns:views          ="clr-namespace:DataGenerator.Views"
	mc:Ignorable         ="d"
	d:DataContext        ="{d:DesignInstance Type=viewModels:MainViewModel}">

	<Border
		Margin          ="0,0,0,8"
		Padding         ="10,8"
		Background      ="{DynamicResource ErrorBackgroundBrush}"
		BorderBrush     ="{DynamicResource ErrorBorderBrush}"
		BorderThickness ="1"
		CornerRadius    ="6">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row          ="0"
				Grid.Column       ="0"
				Margin            ="0,2,10,0"
				VerticalAlignment ="Top"
				Style             ="{StaticResource IconTextStyle}"
				FontSize          ="20"
				Foreground        ="{DynamicResource ErrorBrush}"
				Text              ="&#xE783;" />

			<!-- Long messages scroll here, so the panel never squashes the rest of the window -->
			<ScrollViewer
				Grid.Row                      ="0"
				Grid.Column                   ="1"
				MaxHeight                     ="{x:Static views:ErrorPanel.MAXIMUM_MESSAGE_HEIGHT}"
				Focusable                     ="False"
				HorizontalScrollBarVisibility ="Disabled"
				VerticalScrollBarVisibility   ="Auto"
				ToolTip                       ="{StaticResource ErrorMessageAreaHint}">
				<StackPanel
					Margin="0,0,4,0">
					<!-- What happened and where -->
					<TextBlock
						FontWeight   ="SemiBold"
						Foreground   ="{DynamicResource ErrorBrush}"
						Text         ="{Binding ErrorSummary}"
						TextWrapping ="Wrap" />

					<DockPanel
						Margin="0,4,0,0">
						<TextBlock
							DockPanel.Dock ="Left"
							Margin         ="0,0,6,0"
							FontWeight     ="SemiBold"
							Text           ="Where:" />

						<TextBlock
							Text         ="{Binding ErrorLocation}"
							TextWrapping ="Wrap" />
					</DockPanel>
				</StackPanel>
			</ScrollViewer>

			<StackPanel
				Grid.Row          ="0"
				Grid.Column       ="2"
				Margin            ="10,0,0,0"
				VerticalAlignment ="Top"
				Orientation       ="Horizontal">
				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding CopyErrorCommand}"
					Content ="Copy"
					ToolTip ="{StaticResource CopyErrorHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE8C8;" />

				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding DismissErrorCommand}"
					Content ="Dismiss"
					ToolTip ="{StaticResource DismissErrorHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE711;" />
			</StackPanel>

			<!-- Technical details for support, outside the message area so the details box is never clipped by it -->
			<Expander
				Grid.Row        ="1"
				Grid.Column     ="1"
				Grid.ColumnSpan ="2"
				Margin          ="0,6,0,0"
				Header          ="Details"
				ToolTip         ="{StaticResource ErrorDetailsHint}">
				<TextBox
					MaxHeight    ="160"
					Margin       ="0,4,0,0"
					FontFamily   ="{StaticResource CodeFontFamily}"
					FontSize     ="12"
					IsReadOnly   ="True"
					Text         ="{Binding	ErrorDetails,
													Mode=OneWay}"
					TextWrapping ="NoWrap"
					ScrollViewer.HorizontalScrollBarVisibility ="Auto"
					ScrollViewer.VerticalScrollBarVisibility   ="Auto" />
			</Expander>
		</Grid>
	</Border>
</UserControl>