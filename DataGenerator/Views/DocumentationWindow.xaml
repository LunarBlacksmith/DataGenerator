<Window
	x:Class               ="DataGenerator.Views.DocumentationWindow"
	xmlns                 ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x               ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:infrastructure  ="clr-namespace:DataGenerator.Infrastructure"
	Title                 ="DataGenerator documentation"
	Width                 ="1000"
	Height                ="750"
	MinWidth              ="600"
	MinHeight             ="400"
	Background            ="{DynamicResource WindowBackgroundBrush}"
	Foreground            ="{DynamicResource TextBrush}"
	ShowInTaskbar         ="False"
	WindowStartupLocation ="CenterOwner">
	<Grid Margin ="12">
		<Grid.RowDefinitions>
			<RowDefinition Height ="Auto" />
			<RowDefinition Height ="Auto" />
			<RowDefinition Height ="*" />
		</Grid.RowDefinitions>
		<!-- Topic selection navigates the bundled guides without replacing any generation settings -->
		<ComboBox
			ItemsSource       ="{Binding Topics}"
			SelectedItem      ="{Binding SelectedTopic, Mode=TwoWay}"
			DisplayMemberPath ="DisplayName"
			ToolTip           ="Choose a documentation guide. All guides are bundled with this app and available offline." />
		<TextBlock
			Grid.Row     ="1"
			Margin       ="0,8"
			Text         ="Links open other guides or headings; web links open in your browser. Ctrl+F finds text, Ctrl+wheel zooms and Shift+wheel scrolls wide tables sideways."
			TextWrapping ="Wrap"
			Foreground   ="{DynamicResource SecondaryTextBrush}" />
		<!-- Formatted guide rendered from Markdown and shown in WebView2 with the current theme colours; the raw Markdown is
		     shown instead when the WebView2 Runtime is not installed -->
		<Border
			Grid.Row        ="2"
			BorderBrush     ="{DynamicResource SectionBorderBrush}"
			BorderThickness ="1">
			<infrastructure:MarkdownDocumentView
				Html                   ="{Binding Html}"
				Markdown               ="{Binding Text}"
				Fragment               ="{Binding Fragment}"
				LinkCommand            ="{Binding OpenLinkCommand}"
				PageBackground         ="{DynamicResource WindowBackgroundBrush}"
				PageForeground         ="{DynamicResource TextBrush}"
				SecondaryForeground    ="{DynamicResource SecondaryTextBrush}"
				LinkBrush              ="{DynamicResource AccentBrush}"
				RuleBrush              ="{DynamicResource SectionBorderBrush}"
				CodeBackground         ="{DynamicResource InputBackgroundBrush}"
				HeaderBackground       ="{DynamicResource HeaderStripBrush}"
				AlternateRowBackground ="{DynamicResource AlternateRowBrush}" />
		</Border>
	</Grid>
</Window>
