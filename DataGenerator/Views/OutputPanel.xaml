<UserControl
	x:Class              ="DataGenerator.Views.OutputPanel"
	xmlns                ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x              ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d              ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc             ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels     ="clr-namespace:DataGenerator.ViewModels"
	mc:Ignorable         ="d"
	d:DataContext        ="{d:DesignInstance Type=viewModels:MainViewModel}">

	<UserControl.Resources>
		<Style
			x:Key      ="PostGenerationWatermarkStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Setter
				Property ="Visibility"
				Value    ="Collapsed" />

			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding PostGeneration.Text}"
					Value   ="">
					<Setter
						Property ="Visibility"
						Value    ="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style
			x:Key      ="PostGenerationSummaryStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Style.Triggers>
				<DataTrigger
					Binding ="{Binding PostGeneration.HasProblem}"
					Value   ="True">
					<Setter
						Property ="Foreground"
						Value    ="{DynamicResource WarningBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<GroupBox
		Header ="Generation output"
		Style  ="{StaticResource OutputSectionStyle}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Where the generated rows go -->
			<Label
				Grid.Row    ="0"
				Grid.Column ="0"
				Content     ="Output mode:" />

			<WrapPanel
				Grid.Row    ="0"
				Grid.Column ="1">
				<RadioButton
					Content   ="SQL _file"
					GroupName ="OutputMode"
					IsChecked ="{Binding	IsSqlFileMode,
												Mode=TwoWay}"
					ToolTip   ="{StaticResource SqlFileModeHint}" />

				<RadioButton
					Margin    ="12,4,4,4"
					Content   ="D_irect insert"
					GroupName ="OutputMode"
					IsChecked ="{Binding	IsDirectInsertMode,
												Mode=TwoWay}"
					ToolTip   ="{StaticResource DirectInsertModeHint}" />

				<CheckBox
					Margin    ="20,4,4,4"
					Content   ="I _confirm these are authorised non-production or test databases."
					IsChecked ="{Binding	ConfirmTestDatabase,
												Mode=TwoWay}"
					IsEnabled ="{Binding IsDirectInsertMode}"
					ToolTip   ="{StaticResource ConfirmTestDatabaseHint}" />
			</WrapPanel>

			<Label
				Grid.Row    ="1"
				Grid.Column ="0"
				Content     ="SQL script:" />

			<Grid
				Grid.Row    ="1"
				Grid.Column ="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Column ="0"
					Background  ="Transparent"
					ToolTip     ="{StaticResource OutputFileHint}">
					<TextBox
						IsEnabled ="{Binding IsSqlFileMode}"
						Text      ="{Binding	OutputFilePath,
													Mode=TwoWay,
													UpdateSourceTrigger=PropertyChanged}" />
				</Grid>

				<Button
					Grid.Column ="1"
					Command     ="{Binding BrowseOutputCommand}"
					Content     ="_Browse…"
					ToolTip     ="{StaticResource BrowseOutputHint}" />

				<Button
					Grid.Column ="2"
					Command     ="{Binding OpenOutputFolderCommand}"
					Content     ="_Open output folder"
					ToolTip     ="{StaticResource OpenOutputFolderHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE838;" />
			</Grid>

			<!-- What happens to the rows already in the tables -->
			<Label
				Grid.Row    ="2"
				Grid.Column ="0"
				Content     ="Existing data:" />

			<WrapPanel
				Grid.Row    ="2"
				Grid.Column ="1">
				<CheckBox
					Content   ="Clear e_xisting data first"
					IsChecked ="{Binding	ClearExistingData,
												Mode=TwoWay}"
					ToolTip   ="{StaticResource ClearExistingDataHint}" />

				<RadioButton
					Margin    ="12,4,4,4"
					Content   ="Included tables only"
					GroupName ="CleanupScope"
					IsChecked ="{Binding	ClearIncludedTablesOnly,
												Mode=TwoWay}"
					IsEnabled ="{Binding ClearExistingData}"
					ToolTip   ="{StaticResource ClearIncludedTablesHint}" />

				<RadioButton
					Content   ="All tables in their databases"
					GroupName ="CleanupScope"
					IsChecked ="{Binding	ClearAllTablesInDatabases,
												Mode=TwoWay}"
					IsEnabled ="{Binding ClearExistingData}"
					ToolTip   ="{StaticResource ClearAllTablesHint}" />

				<CheckBox
					Margin    ="20,4,4,4"
					Content   ="Reset identity seeds"
					IsChecked ="{Binding	ResetIdentitySeeds,
												Mode=TwoWay}"
					IsEnabled ="{Binding ClearExistingData}"
					ToolTip   ="{StaticResource ResetIdentitySeedsHint}" />
			</WrapPanel>

			<!-- What runs after the inserts, inside the same transaction -->
			<Label
				Grid.Row          ="3"
				Grid.Column       ="0"
				Margin            ="0,6,0,0"
				VerticalAlignment ="Top"
				Content           ="Finally run:" />

			<Grid
				Grid.Row    ="3"
				Grid.Column ="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>

				<TextBox
					Grid.Row                      ="0"
					Grid.Column                   ="0"
					MinHeight                     ="27"
					MaxHeight                     ="96"
					VerticalContentAlignment      ="Top"
					AcceptsReturn                 ="True"
					FontFamily                    ="{StaticResource CodeFontFamily}"
					HorizontalScrollBarVisibility ="Auto"
					VerticalScrollBarVisibility   ="Auto"
					TextWrapping                  ="NoWrap"
					Text                          ="{Binding	PostGeneration.Text,
																		Mode=TwoWay,
																		UpdateSourceTrigger=PropertyChanged}"
					ToolTip                       ="{StaticResource PostGenerationSqlHint}" />

				<TextBlock
					Grid.Row         ="0"
					Grid.Column      ="0"
					Margin            ="11,8,8,0"
					VerticalAlignment ="Top"
					Style             ="{StaticResource PostGenerationWatermarkStyle}"
					FontStyle         ="Italic"
					IsHitTestVisible  ="False"
					Text              ="Optional: stored procedure names (one per line, e.g. dbo.RebuildTotals) or SQL to run before the commit"
					TextTrimming      ="CharacterEllipsis" />

				<Label
					Grid.Row          ="0"
					Grid.Column       ="1"
					Margin            ="8,6,0,0"
					VerticalAlignment ="Top"
					Content           ="in database:" />

				<ComboBox
					Grid.Row          ="0"
					Grid.Column       ="2"
					MinWidth          ="160"
					VerticalAlignment ="Top"
					ItemsSource       ="{Binding PostGeneration.DatabaseNames}"
					SelectedItem      ="{Binding	PostGeneration.DatabaseName,
															Mode=TwoWay}"
					ToolTip           ="{StaticResource PostGenerationDatabaseHint}" />

				<TextBlock
					Grid.Row        ="1"
					Grid.Column     ="0"
					Grid.ColumnSpan ="3"
					Margin          ="4,0,4,2"
					Style           ="{StaticResource PostGenerationSummaryStyle}"
					Text            ="{Binding PostGeneration.Summary}"
					TextWrapping    ="Wrap"
					Visibility      ="{Binding	PostGeneration.HasSummary,
														Converter={StaticResource BooleanToVisibilityConverter}}" />
			</Grid>

			<TextBlock
				Grid.Row     ="4"
				Grid.Column  ="1"
				Margin       ="4,2,4,0"
				Style        ="{StaticResource SecondaryTextStyle}"
				Text         ="{Binding GenerationSummary}"
				TextWrapping ="Wrap" />

			<!-- Actions -->
			<StackPanel
				Grid.Row          ="0"
				Grid.RowSpan      ="5"
				Grid.Column       ="2"
				Margin            ="12,0,0,0"
				VerticalAlignment ="Center">
				<Button
					MinWidth  ="150"
					MinHeight ="36"
					Style     ="{StaticResource AccentButtonStyle}"
					Command   ="{Binding GenerateCommand}"
					Content   ="_Generate"
					FontSize  ="14"
					ToolTip   ="{StaticResource GenerateHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE768;" />

				<Button
					Command ="{Binding CancelCommand}"
					Content ="Cancel"
					ToolTip ="{StaticResource CancelHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE71A;" />
			</StackPanel>
		</Grid>
	</GroupBox>
</UserControl>