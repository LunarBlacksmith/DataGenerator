<Window
	x:Class               ="DataGenerator.Views.SavedSettingsManagerWindow"
	xmlns                 ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x               ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d               ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc              ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure  ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels      ="clr-namespace:DataGenerator.ViewModels"
	mc:Ignorable          ="d"
	d:DataContext         ="{d:DesignInstance Type=viewModels:SavedSettingsManagerViewModel}"
	Title                 ="Saved column settings"
	Width                 ="960"
	Height                ="560"
	MinWidth              ="640"
	MinHeight             ="340"
	Background            ="{DynamicResource WindowBackgroundBrush}"
	Foreground            ="{DynamicResource TextBrush}"
	ShowInTaskbar         ="False"
	UseLayoutRounding     ="True"
	WindowStartupLocation ="CenterOwner">
	<Window.Resources>
		<!-- Shared DataGrid text style: centred and trimmed so long saved-setting values fit the row -->
		<Style
			x:Key      ="GridCellTextStyle"
			TargetType ="TextBlock">
			<Setter
				Property ="Margin"
				Value    ="4,0" />
			<Setter
				Property ="VerticalAlignment"
				Value    ="Center" />
			<Setter
				Property ="TextTrimming"
				Value    ="CharacterEllipsis" />
		</Style>

		<!-- Monospace variant for saved setting summaries -->
		<Style
			x:Key      ="GridCodeTextStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource GridCellTextStyle}">
			<Setter
				Property ="FontFamily"
				Value    ="{StaticResource CodeFontFamily}" />
		</Style>
	</Window.Resources>

	<Grid
		Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Explains how saved settings are picked, applied automatically and shared -->
		<TextBlock
			Grid.Row     ="0"
			Margin       ="4,0,4,8"
			Style        ="{StaticResource SecondaryTextStyle}"
			Text         ="Saved settings can be picked from the saved-settings menu of any column whose SQL type suits them (the button at the right of the column's Settings cell). Tick Automatic to apply a setting to the columns it was saved for whenever a new row set is created. Export the settings to share them with colleagues working on the same project."
			TextWrapping ="Wrap" />

		<Grid
			Grid.Row ="1">
			<!-- Editable list of saved settings; selection enables delete and row edits save through the manager view model -->
			<DataGrid
				AutoGenerateColumns ="False"
				CanUserAddRows      ="False"
				CanUserDeleteRows   ="False"
				ItemsSource         ="{Binding Settings}"
				SelectedItem        ="{Binding	SelectedSetting,
															Mode=TwoWay}"
				SelectionMode       ="Single"
				ToolTip             ="{StaticResource SavedSettingsGridHint}">
				<DataGrid.Columns>
					<!-- Name column edits the saved setting name and validates on lost focus -->
					<DataGridTemplateColumn
						Width    ="1.2*"
						MinWidth ="140">
						<DataGridTemplateColumn.Header>
							<TextBlock
								Text    ="Name"
								ToolTip ="{StaticResource SavedSettingNameHint}" />
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate
								DataType="{x:Type viewModels:SavedSettingRowViewModel}">
								<TextBox
									Margin    ="0,2"
									MaxLength ="100"
									Text      ="{Binding	Name,
																Mode=TwoWay,
																UpdateSourceTrigger=LostFocus}"
									ToolTip   ="{StaticResource SavedSettingNameHint}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Generation mode that the saved values belong to -->
					<DataGridTemplateColumn
						Width    ="110"
						MinWidth ="90">
						<DataGridTemplateColumn.Header>
							<TextBlock
								Text    ="Mode"
								ToolTip ="{StaticResource SavedSettingModeColumnHint}" />
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate
								DataType="{x:Type viewModels:SavedSettingRowViewModel}">
								<TextBlock
									Style ="{StaticResource GridCellTextStyle}"
									Text  ="{Binding ModeName}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Human-readable summary of the stored rule values -->
					<DataGridTemplateColumn
						Width    ="2*"
						MinWidth ="160">
						<DataGridTemplateColumn.Header>
							<TextBlock
								Text    ="Settings"
								ToolTip ="{StaticResource SavedSettingSummaryColumnHint}" />
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate
								DataType="{x:Type viewModels:SavedSettingRowViewModel}">
								<TextBlock
									Style   ="{StaticResource GridCodeTextStyle}"
									Text    ="{Binding Summary}"
									ToolTip ="{Binding Summary}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Automatic toggle is enabled only when the setting still has a target column -->
					<DataGridTemplateColumn
						Width    ="90"
						MinWidth ="80">
						<DataGridTemplateColumn.Header>
							<TextBlock
								Text    ="Automatic"
								ToolTip ="{StaticResource SavedSettingAutomaticColumnHint}" />
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate
								DataType="{x:Type viewModels:SavedSettingRowViewModel}">
								<CheckBox
									HorizontalAlignment ="Center"
									IsChecked           ="{Binding	ApplyAutomatically,
																				Mode=TwoWay,
																				UpdateSourceTrigger=PropertyChanged}"
									IsEnabled           ="{Binding HasTarget}"
									ToolTip             ="{StaticResource SavedSettingAutomaticColumnHint}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Target table or column scope used for automatic application -->
					<DataGridTemplateColumn
						Width    ="1.4*"
						MinWidth ="140">
						<DataGridTemplateColumn.Header>
							<TextBlock
								Text    ="Applies to"
								ToolTip ="{StaticResource SavedSettingTargetColumnHint}" />
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate
								DataType="{x:Type viewModels:SavedSettingRowViewModel}">
								<TextBlock
									Style   ="{StaticResource GridCellTextStyle}"
									Text    ="{Binding TargetText}"
									ToolTip ="{Binding TargetText}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Empty state shown until the library contains at least one saved setting -->
			<TextBlock
				Style      ="{StaticResource PlaceholderTextStyle}"
				Text       ="No saved settings yet. Open the saved-settings menu of a column (the button at the right of its Settings cell) and choose 'Save these settings…', or import a file a colleague exported."
				Visibility ="{Binding	HasSettings,
												Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
		</Grid>

		<DockPanel
			Grid.Row ="2"
			Margin   ="0,8,0,0">
			<!-- Window actions and saved-settings library operations -->
			<Button
				DockPanel.Dock ="Right"
				MinWidth       ="90"
				Content        ="Close"
				IsCancel       ="True"
				ToolTip        ="{StaticResource CloseWindowHint}" />

			<StackPanel
				Orientation="Horizontal">
				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding DeleteCommand}"
					Content ="Delete"
					ToolTip ="{StaticResource DeleteSavedSettingHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE74D;" />

				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding ImportCommand}"
					Content ="Import…"
					ToolTip ="{StaticResource ImportSavedSettingsHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE8B5;" />

				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding ExportCommand}"
					Content ="Export…"
					ToolTip ="{StaticResource ExportSavedSettingsHint}"
					infrastructure:ButtonIcon.Glyph ="&#xEDE1;" />

				<Button
					Style   ="{StaticResource ToolbarButtonStyle}"
					Command ="{Binding ApplyToOpenCommand}"
					Content ="Apply automatic settings to open tables"
					ToolTip ="{StaticResource ApplyAutomaticSettingsHint}"
					infrastructure:ButtonIcon.Glyph ="&#xE895;" />
			</StackPanel>
		</DockPanel>

		<DockPanel
			Grid.Row ="3"
			Margin   ="4,6,4,0">
			<!-- Last operation result on the right, storage location on the left -->
			<TextBlock
				DockPanel.Dock ="Right"
				Margin         ="12,0,0,0"
				Style          ="{StaticResource SecondaryTextStyle}"
				Text           ="{Binding StatusText}" />

			<TextBlock
				Style        ="{StaticResource SecondaryTextStyle}"
				Text         ="{Binding	FilePath,
												StringFormat='Saved in {0}'}"
				TextTrimming ="CharacterEllipsis"
				ToolTip      ="{StaticResource SavedSettingsFileHint}" />
		</DockPanel>
	</Grid>
</Window>