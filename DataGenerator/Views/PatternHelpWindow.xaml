<Window
	x:Class               ="DataGenerator.Views.PatternHelpWindow"
	xmlns                 ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x               ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d               ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc              ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure  ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels      ="clr-namespace:DataGenerator.ViewModels"
	mc:Ignorable          ="d"
	d:DataContext         ="{d:DesignInstance Type=viewModels:PatternHelpViewModel}"
	Title                 ="Pattern language reference"
	Width                 ="900"
	Height                ="720"
	MinWidth              ="720"
	MinHeight             ="450"
	Background            ="{DynamicResource WindowBackgroundBrush}"
	Foreground            ="{DynamicResource TextBrush}"
	ShowInTaskbar         ="False"
	UseLayoutRounding     ="True"
	WindowStartupLocation ="CenterOwner">
	<Window.Resources>
		<Style
			x:Key      ="HeadingTextStyle"
			TargetType ="TextBlock">
			<Setter
				Property ="Margin"
				Value    ="0,16,0,6" />
			<Setter
				Property ="FontSize"
				Value    ="15" />
			<Setter
				Property ="FontWeight"
				Value    ="SemiBold" />
			<Setter
				Property ="Foreground"
				Value    ="{DynamicResource SectionHeaderTextBrush}" />
		</Style>

		<Style
			x:Key      ="NoteTextStyle"
			TargetType ="TextBlock"
			BasedOn    ="{StaticResource SecondaryTextStyle}">
			<Setter
				Property ="Margin"
				Value    ="0,6,0,0" />
			<Setter
				Property ="TextWrapping"
				Value    ="Wrap" />
		</Style>

		<Style
			x:Key      ="CodeTextStyle"
			TargetType ="TextBlock">
			<Setter
				Property ="VerticalAlignment"
				Value    ="Center" />
			<Setter
				Property ="FontFamily"
				Value    ="{StaticResource CodeFontFamily}" />
			<Setter
				Property ="FontSize"
				Value    ="12" />
			<Setter
				Property ="TextWrapping"
				Value    ="Wrap" />
		</Style>

		<Style
			x:Key      ="TableHeaderStyle"
			TargetType ="Border">
			<Setter
				Property ="Padding"
				Value    ="8,5" />
			<Setter
				Property ="Background"
				Value    ="{DynamicResource HeaderStripBrush}" />
			<Setter
				Property ="BorderBrush"
				Value    ="{DynamicResource GridLineBrush}" />
			<Setter
				Property ="BorderThickness"
				Value    ="1" />
			<Setter
				Property ="CornerRadius"
				Value    ="4,4,0,0" />
			<Setter
				Property ="TextElement.FontWeight"
				Value    ="SemiBold" />
			<Setter
				Property ="TextElement.Foreground"
				Value    ="{DynamicResource SectionHeaderTextBrush}" />
		</Style>

		<Style
			x:Key      ="TableStyle"
			TargetType ="ItemsControl">
			<Setter
				Property ="Focusable"
				Value    ="False" />
			<Setter
				Property ="AlternationCount"
				Value    ="2" />
			<Setter
				Property ="BorderBrush"
				Value    ="{DynamicResource GridLineBrush}" />
			<Setter
				Property ="BorderThickness"
				Value    ="1,0,1,0" />
		</Style>

		<Style
			x:Key      ="TableRowStyle"
			TargetType ="Border">
			<Setter
				Property ="Padding"
				Value    ="8,5" />
			<Setter
				Property ="Background"
				Value    ="{DynamicResource RowBrush}" />
			<Setter
				Property ="BorderBrush"
				Value    ="{DynamicResource GridLineBrush}" />
			<Setter
				Property ="BorderThickness"
				Value    ="0,0,0,1" />
		</Style>

		<!-- One line of the syntax tables; the column widths are shared by the header and every row -->
		<DataTemplate
			x:Key    ="SyntaxRowTemplate"
			DataType ="{x:Type viewModels:PatternSyntaxHelp}">
			<Border
				x:Name ="Row"
				Style  ="{StaticResource TableRowStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width           ="Auto"
							MaxWidth        ="250"
							SharedSizeGroup ="Syntax" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width           ="Auto"
							MaxWidth        ="250"
							SharedSizeGroup ="Example" />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column ="0"
						Margin      ="0,0,16,0"
						Style       ="{StaticResource CodeTextStyle}"
						FontWeight  ="SemiBold"
						Text        ="{Binding Syntax}" />

					<TextBlock
						Grid.Column       ="1"
						Margin            ="0,0,16,0"
						VerticalAlignment ="Center"
						Text              ="{Binding Description}"
						TextWrapping      ="Wrap" />

					<TextBlock
						Grid.Column ="2"
						Style       ="{StaticResource CodeTextStyle}"
						Foreground  ="{DynamicResource SecondaryTextBrush}"
						Text        ="{Binding Example}" />
				</Grid>
			</Border>

			<DataTemplate.Triggers>
				<DataTrigger
					Binding ="{Binding	Path=(ItemsControl.AlternationIndex),
												RelativeSource={RelativeSource TemplatedParent}}"
					Value   ="1">
					<Setter
						TargetName ="Row"
						Property   ="Background"
						Value      ="{DynamicResource AlternateRowBrush}" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<DataTemplate
			x:Key="SyntaxHeaderTemplate">
			<Border
				Style   ="{StaticResource TableHeaderStyle}"
				ToolTip ="{StaticResource SyntaxTableHint}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width           ="Auto"
							MaxWidth        ="250"
							SharedSizeGroup ="Syntax" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width           ="Auto"
							MaxWidth        ="250"
							SharedSizeGroup ="Example" />
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column ="0"
						Margin      ="0,0,16,0"
						Text        ="Syntax" />

					<TextBlock
						Grid.Column ="1"
						Margin      ="0,0,16,0"
						Text        ="Meaning" />

					<TextBlock
						Grid.Column ="2"
						Text        ="Example" />
				</Grid>
			</Border>
		</DataTemplate>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>

		<!-- Try-it box: the values a pattern generates for the first rows -->
		<GroupBox
			Grid.Row ="0"
			Margin   ="12,12,12,8"
			Header   ="Try a pattern"
			Style    ="{StaticResource RulesSectionStyle}">
			<StackPanel>
				<Grid
					Background ="Transparent"
					ToolTip    ="{StaticResource PatternTryHint}">
					<TextBox
						FontFamily   ="{StaticResource CodeFontFamily}"
						FontSize     ="13"
						Text         ="{Binding	Expression,
														Mode=TwoWay,
														UpdateSourceTrigger=PropertyChanged}"
						TextWrapping ="Wrap" />
				</Grid>

				<TextBlock
					Margin       ="4,2,4,4"
					Foreground   ="{DynamicResource ErrorBrush}"
					Text         ="{Binding ErrorMessage}"
					TextWrapping ="Wrap"
					Visibility   ="{Binding	HasError,
													Converter={StaticResource BooleanToVisibilityConverter}}" />

				<ItemsControl
					Focusable   ="False"
					ItemsSource ="{Binding Samples}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate
							DataType="{x:Type viewModels:PatternSample}">
							<Border
								Margin          ="4"
								Padding         ="8,3"
								Background      ="{DynamicResource RowBrush}"
								BorderBrush     ="{DynamicResource SectionBorderBrush}"
								BorderThickness ="1"
								CornerRadius    ="4">
								<StackPanel
									Orientation="Horizontal">
									<TextBlock
										Margin ="0,0,8,0"
										Style  ="{StaticResource SecondaryTextStyle}">
										<Run
											Text="Row" />

										<Run
											Text="{Binding	RowNumber,
																Mode=OneWay}" />
									</TextBlock>

									<TextBlock
										Style    ="{StaticResource CodeTextStyle}"
										FontSize ="13"
										Text     ="{Binding Value}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</GroupBox>

		<!-- Reference -->
		<ScrollViewer
			Grid.Row                      ="1"
			HorizontalScrollBarVisibility ="Disabled"
			VerticalScrollBarVisibility   ="Auto">
			<StackPanel
				Margin="14,0,14,14">
				<TextBlock
					Text         ="A pattern describes the values of a column in plain English. Every row gets its own value: sequences count on from row to row, and the random parts are picked again for every row. Keywords and function names are not case-sensitive."
					TextWrapping ="Wrap" />

				<TextBlock
					Style ="{StaticResource HeadingTextStyle}"
					Text  ="Combining parts" />

				<StackPanel
					Grid.IsSharedSizeScope="True">
					<ContentControl
						Content         ="{Binding}"
						ContentTemplate ="{StaticResource SyntaxHeaderTemplate}"
						Focusable       ="False" />

					<ItemsControl
						Style        ="{StaticResource TableStyle}"
						ItemTemplate ="{StaticResource SyntaxRowTemplate}"
						ItemsSource  ="{Binding Operators}" />
				</StackPanel>

				<TextBlock
					Style ="{StaticResource NoteTextStyle}"
					Text  ="REPEATED is applied first, then OR, then FOLLOWED BY, so A FOLLOWED BY B OR C means A FOLLOWED BY (B OR C). Use parentheses to group parts differently." />

				<TextBlock
					Style ="{StaticResource HeadingTextStyle}"
					Text  ="Functions" />

				<StackPanel
					Grid.IsSharedSizeScope="True">
					<ContentControl
						Content         ="{Binding}"
						ContentTemplate ="{StaticResource SyntaxHeaderTemplate}"
						Focusable       ="False" />

					<ItemsControl
						Style        ="{StaticResource TableStyle}"
						ItemTemplate ="{StaticResource SyntaxRowTemplate}"
						ItemsSource  ="{Binding Functions}" />
				</StackPanel>

				<TextBlock
					Style ="{StaticResource NoteTextStyle}"
					Text  ="Ranges can be written as 1-1000, 1..1000 or 1 TO 1000. Optional arguments can be left out from the end, or named, for example SEQ(1-999999, digits=6)." />

				<TextBlock
					Style ="{StaticResource HeadingTextStyle}"
					Text  ="Examples" />

				<ItemsControl
					Style                  ="{StaticResource TableStyle}"
					BorderThickness        ="1,1,1,0"
					Grid.IsSharedSizeScope ="True"
					ItemsSource            ="{Binding Examples}">
					<ItemsControl.ItemTemplate>
						<DataTemplate
							DataType="{x:Type viewModels:PatternExample}">
							<Border
								x:Name  ="Row"
								Padding ="8,2"
								Style   ="{StaticResource TableRowStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width           ="Auto"
											SharedSizeGroup ="Title" />
										<ColumnDefinition
											Width="*" />
										<ColumnDefinition
											Width="Auto" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column       ="0"
										Margin            ="0,0,16,0"
										VerticalAlignment ="Center"
										FontWeight        ="SemiBold"
										Text              ="{Binding Title}" />

									<TextBlock
										Grid.Column ="1"
										Margin      ="0,0,8,0"
										Style       ="{StaticResource CodeTextStyle}"
										Text        ="{Binding Expression}" />

									<Button
										Grid.Column      ="2"
										Style            ="{StaticResource ToolbarButtonStyle}"
										Command          ="{Binding	DataContext.UseExampleCommand,
																				RelativeSource={RelativeSource AncestorType=Window}}"
										CommandParameter ="{Binding}"
										Content          ="Try it"
										ToolTip          ="{StaticResource UseExampleHint}"
										infrastructure:ButtonIcon.Glyph ="&#xE768;" />
								</Grid>
							</Border>

							<DataTemplate.Triggers>
								<DataTrigger
									Binding ="{Binding	Path=(ItemsControl.AlternationIndex),
																RelativeSource={RelativeSource TemplatedParent}}"
									Value   ="1">
									<Setter
										TargetName ="Row"
										Property   ="Background"
										Value      ="{DynamicResource AlternateRowBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>