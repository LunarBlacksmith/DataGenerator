<Window
	x:Class                     ="DataGenerator.Views.SaveColumnSettingWindow"
	xmlns                       ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x                     ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d                     ="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc                    ="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:infrastructure        ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:viewModels            ="clr-namespace:DataGenerator.ViewModels"
	mc:Ignorable                ="d"
	d:DataContext               ="{d:DesignInstance Type=viewModels:SaveColumnSettingViewModel}"
	Title                       ="Save column settings"
	Width                       ="520"
	MinWidth                    ="420"
	Background                  ="{DynamicResource WindowBackgroundBrush}"
	Foreground                  ="{DynamicResource TextBrush}"
	FocusManager.FocusedElement ="{Binding ElementName=NameTextBox}"
	ResizeMode                  ="NoResize"
	ShowInTaskbar               ="False"
	SizeToContent               ="Height"
	UseLayoutRounding           ="True"
	WindowStartupLocation       ="CenterOwner"
	infrastructure:DialogCloser.DialogResult ="{Binding DialogResult}">
	<Window.Resources>
		<Style
			x:Key      ="DialogMessageStyle"
			TargetType ="TextBlock">
			<Setter
				Property ="Margin"
				Value    ="4,6,4,0" />
			<Setter
				Property ="TextWrapping"
				Value    ="Wrap" />

			<Style.Triggers>
				<Trigger
					Property ="Text"
					Value    ="">
					<Setter
						Property ="Visibility"
						Value    ="Collapsed" />
				</Trigger>

				<Trigger
					Property ="Text"
					Value    ="{x:Null}">
					<Setter
						Property ="Visibility"
						Value    ="Collapsed" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<StackPanel
		Margin="16,12,16,12">
		<TextBlock
			Margin       ="4,0,4,8"
			Style        ="{StaticResource SecondaryTextStyle}"
			Text         ="{Binding	ColumnDescription,
											StringFormat='Saves the generation settings of {0} for reuse in other columns, row sets and sessions.'}"
			TextWrapping ="Wrap" />

		<Label
			Content ="_Name"
			Target  ="{Binding ElementName=NameTextBox}" />

		<TextBox
			x:Name    ="NameTextBox"
			MaxLength ="100"
			Text      ="{Binding	Name,
										UpdateSourceTrigger=PropertyChanged}"
			ToolTip   ="{StaticResource SavedSettingNameHint}" />

		<Label
			Margin  ="0,6,0,0"
			Content ="Settings" />

		<Border
			Margin          ="4"
			Padding         ="8,6"
			Background      ="{DynamicResource RulesSectionBrush}"
			BorderBrush     ="{DynamicResource SectionBorderBrush}"
			BorderThickness ="1"
			CornerRadius    ="4"
			ToolTip         ="{StaticResource SavedSettingValuesHint}">
			<TextBlock
				FontFamily   ="{StaticResource CodeFontFamily}"
				Text         ="{Binding ValuesSummary}"
				TextWrapping ="Wrap" />
		</Border>

		<Label
			Margin  ="0,6,0,0"
			Content ="Apply automatically" />

		<RadioButton
			Content   ="Never (only when picked from a column's saved-settings menu)"
			IsChecked ="{Binding ApplyNever}"
			ToolTip   ="{StaticResource ApplyNeverHint}" />

		<RadioButton
			Content   ="{Binding ThisColumnText}"
			IsChecked ="{Binding ApplyToThisColumn}"
			ToolTip   ="{StaticResource ApplyToThisColumnHint}" />

		<RadioButton
			Content   ="{Binding EveryColumnWithNameText}"
			IsChecked ="{Binding ApplyToEveryColumnWithName}"
			ToolTip   ="{StaticResource ApplyToEveryColumnWithNameHint}" />

		<TextBlock
			Foreground ="{DynamicResource WarningBrush}"
			Style      ="{StaticResource DialogMessageStyle}"
			Text       ="{Binding ReplaceWarning}" />

		<TextBlock
			Foreground ="{DynamicResource WarningBrush}"
			Style      ="{StaticResource DialogMessageStyle}"
			Text       ="{Binding ConflictWarning}" />

		<TextBlock
			Foreground ="{DynamicResource ErrorBrush}"
			Style      ="{StaticResource DialogMessageStyle}"
			Text       ="{Binding ErrorMessage}" />

		<StackPanel
			Margin              ="0,12,0,0"
			HorizontalAlignment ="Right"
			Orientation         ="Horizontal">
			<Button
				MinWidth  ="90"
				Style     ="{StaticResource AccentButtonStyle}"
				Command   ="{Binding SaveCommand}"
				Content   ="_Save"
				IsDefault ="True"
				ToolTip   ="{StaticResource ConfirmSaveSettingHint}"
				infrastructure:ButtonIcon.Glyph ="&#xE74E;" />

			<Button
				MinWidth ="90"
				Content  ="Cancel"
				IsCancel ="True"
				ToolTip  ="{StaticResource CancelDialogHint}" />
		</StackPanel>
	</StackPanel>
</Window>