<Application
	x:Class              ="DataGenerator.App"
	xmlns                ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x              ="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:infrastructure ="clr-namespace:DataGenerator.Infrastructure"
	xmlns:services       ="clr-namespace:DataGenerator.Services"
	ShutdownMode         ="OnMainWindowClose">
	<Application.Resources>
		<!--
			Application-wide resources. Brushes.Light.xaml is the starting palette; ThemeService swaps it for
			Brushes.Dark.xaml at run time, which is why every colour is used through DynamicResource.
			Hints.xaml holds the hint text of every control, and Controls.xaml the shared styles and templates.
		-->
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="Themes/Brushes.Light.xaml" />

				<ResourceDictionary
					Source="Themes/Hints.xaml" />

				<ResourceDictionary
					Source="Themes/Controls.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Converters shared by all views -->
			<BooleanToVisibilityConverter
				x:Key="BooleanToVisibilityConverter" />

			<infrastructure:InverseBooleanToVisibilityConverter
				x:Key="InverseBooleanToVisibilityConverter" />

			<!-- Suggests pattern functions and keywords in the text boxes that use PatternAutoComplete.Provider -->
			<services:PatternCompletionProvider
				x:Key="PatternCompletionProvider" />
		</ResourceDictionary>
	</Application.Resources>
</Application>