<ResourceDictionary
	xmlns   ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x ="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Window and text -->
	<SolidColorBrush
		x:Key ="WindowBackgroundBrush"
		Color ="#EEF1F5" />

	<SolidColorBrush
		x:Key ="TextBrush"
		Color ="#1F2933" />

	<SolidColorBrush
		x:Key ="SecondaryTextBrush"
		Color ="#5F6B7A" />

	<!-- Section cards: a subtle tint per section with a matching accent bar in the header -->
	<SolidColorBrush
		x:Key ="SectionBorderBrush"
		Color ="#D5DBE3" />

	<SolidColorBrush
		x:Key ="SectionHeaderTextBrush"
		Color ="#33475B" />

	<SolidColorBrush
		x:Key ="ConnectionSectionBrush"
		Color ="#F2F6FC" />

	<SolidColorBrush
		x:Key ="ConnectionAccentBrush"
		Color ="#4A7BB7" />

	<SolidColorBrush
		x:Key ="ExplorerSectionBrush"
		Color ="#F2F9F5" />

	<SolidColorBrush
		x:Key ="ExplorerAccentBrush"
		Color ="#3E9A6A" />

	<SolidColorBrush
		x:Key ="RulesSectionBrush"
		Color ="#F6F4FC" />

	<SolidColorBrush
		x:Key ="RulesAccentBrush"
		Color ="#7C6BC4" />

	<SolidColorBrush
		x:Key ="OutputSectionBrush"
		Color ="#FCF8F0" />

	<SolidColorBrush
		x:Key ="OutputAccentBrush"
		Color ="#C08A2E" />

	<!-- Rows of the database tree and the column rules grid -->
	<SolidColorBrush
		x:Key ="RowBrush"
		Color ="#FFFFFF" />

	<SolidColorBrush
		x:Key ="AlternateRowBrush"
		Color ="#F4F6F9" />

	<SolidColorBrush
		x:Key ="DatabaseRowBrush"
		Color ="#E6EDF6" />

	<SolidColorBrush
		x:Key ="DatabaseAlternateRowBrush"
		Color ="#DDE6F1" />

	<SolidColorBrush
		x:Key ="SelectedRowBrush"
		Color ="#CFE3FA" />

	<SolidColorBrush
		x:Key ="SelectedRowBorderBrush"
		Color ="#7AB2EC" />

	<SolidColorBrush
		x:Key ="HoverOverlayBrush"
		Color ="#1A2B6CB0" />

	<SolidColorBrush
		x:Key ="HiddenRowBrush"
		Color ="#E9EBEE" />

	<SolidColorBrush
		x:Key ="HiddenTextBrush"
		Color ="#9AA1AB" />

	<SolidColorBrush
		x:Key ="PrimaryKeyRowBrush"
		Color ="#F9D5D3" />

	<SolidColorBrush
		x:Key ="PrimaryKeyAlternateRowBrush"
		Color ="#F5CAC7" />

	<SolidColorBrush
		x:Key ="ForeignKeyRowBrush"
		Color ="#FDE2C4" />

	<SolidColorBrush
		x:Key ="ForeignKeyAlternateRowBrush"
		Color ="#FAD7B2" />

	<!-- Status -->
	<SolidColorBrush
		x:Key ="ErrorBrush"
		Color ="#B3261E" />

	<SolidColorBrush
		x:Key ="ErrorBackgroundBrush"
		Color ="#FDECEA" />

	<SolidColorBrush
		x:Key ="ErrorBorderBrush"
		Color ="#F1B8B4" />

	<SolidColorBrush
		x:Key ="WarningBrush"
		Color ="#B26A00" />

	<!-- Buttons and inputs -->
	<SolidColorBrush
		x:Key ="AccentBrush"
		Color ="#2B6CB0" />

	<SolidColorBrush
		x:Key ="AccentHoverBrush"
		Color ="#245A93" />

	<SolidColorBrush
		x:Key ="AccentPressedBrush"
		Color ="#1D4A79" />

	<SolidColorBrush
		x:Key ="ButtonBackgroundBrush"
		Color ="#FBFCFD" />

	<SolidColorBrush
		x:Key ="ButtonBorderBrush"
		Color ="#C3CBD6" />

	<SolidColorBrush
		x:Key ="ButtonHoverBackgroundBrush"
		Color ="#EAF2FB" />

	<SolidColorBrush
		x:Key ="ButtonHoverBorderBrush"
		Color ="#7AB2EC" />

	<SolidColorBrush
		x:Key ="ButtonPressedBackgroundBrush"
		Color ="#D6E6F8" />

	<SolidColorBrush
		x:Key ="InputBackgroundBrush"
		Color ="#FFFFFF" />

	<SolidColorBrush
		x:Key ="InputBorderBrush"
		Color ="#C3CBD6" />

	<SolidColorBrush
		x:Key ="HeaderStripBrush"
		Color ="#E9EDF2" />

	<SolidColorBrush
		x:Key ="GridLineBrush"
		Color ="#E3E7ED" />

	<SolidColorBrush
		x:Key ="StatusBarBrush"
		Color ="#E2E7EE" />

	<SolidColorBrush
		x:Key ="StatusBarBorderBrush"
		Color ="#CDD4DE" />

	<!-- Pop-ups, hints and scroll bars -->
	<SolidColorBrush
		x:Key ="PopupBackgroundBrush"
		Color ="#FFFFFF" />

	<SolidColorBrush
		x:Key ="ToolTipBackgroundBrush"
		Color ="#FFFFFF" />

	<SolidColorBrush
		x:Key ="ToolTipBorderBrush"
		Color ="#B9C2CE" />

	<SolidColorBrush
		x:Key ="ScrollBarTrackBrush"
		Color ="#F0F2F5" />

	<SolidColorBrush
		x:Key ="ScrollBarThumbBrush"
		Color ="#C1C8D1" />

	<SolidColorBrush
		x:Key ="ScrollBarThumbHoverBrush"
		Color ="#A3ADB9" />

	<!-- Key badges -->
	<SolidColorBrush
		x:Key ="PrimaryKeyBadgeBrush"
		Color ="#F3B3AE" />

	<SolidColorBrush
		x:Key ="PrimaryKeyBadgeTextBrush"
		Color ="#7A1F17" />

	<SolidColorBrush
		x:Key ="ForeignKeyBadgeBrush"
		Color ="#F9C893" />

	<SolidColorBrush
		x:Key ="ForeignKeyBadgeTextBrush"
		Color ="#7A4310" />

	<SolidColorBrush
		x:Key ="ForeignTableKeyBadgeBrush"
		Color ="#FBE7C6" />

	<SolidColorBrush
		x:Key ="ForeignTableKeyBadgeBorderBrush"
		Color ="#E0A458" />

	<SolidColorBrush
		x:Key ="IdentityBadgeBrush"
		Color ="#D8E3F0" />

	<SolidColorBrush
		x:Key ="IdentityBadgeTextBrush"
		Color ="#33475B" />

	<SolidColorBrush
		x:Key ="RowSetBadgeBrush"
		Color ="#E3DDF7" />

	<SolidColorBrush
		x:Key ="RowSetBadgeTextBrush"
		Color ="#4B3F8A" />
</ResourceDictionary>