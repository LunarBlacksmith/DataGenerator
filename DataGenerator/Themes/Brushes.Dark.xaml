<ResourceDictionary
	xmlns   ="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x ="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Window and text: application background and default foregrounds -->
	<SolidColorBrush
		x:Key ="WindowBackgroundBrush"
		Color ="#1B1F24" />

	<SolidColorBrush
		x:Key ="TextBrush"
		Color ="#E3E8EE" />

	<SolidColorBrush
		x:Key ="SecondaryTextBrush"
		Color ="#9AA5B1" />

	<!-- Section cards: a subtle tint per section with a matching accent bar in the header -->
	<SolidColorBrush
		x:Key ="SectionBorderBrush"
		Color ="#353C46" />

	<SolidColorBrush
		x:Key ="SectionHeaderTextBrush"
		Color ="#CAD4DF" />

	<SolidColorBrush
		x:Key ="ConnectionSectionBrush"
		Color ="#1F2631" />

	<SolidColorBrush
		x:Key ="ConnectionAccentBrush"
		Color ="#6B9BD6" />

	<SolidColorBrush
		x:Key ="ExplorerSectionBrush"
		Color ="#1E2924" />

	<SolidColorBrush
		x:Key ="ExplorerAccentBrush"
		Color ="#4FB37E" />

	<SolidColorBrush
		x:Key ="RulesSectionBrush"
		Color ="#24222F" />

	<SolidColorBrush
		x:Key ="RulesAccentBrush"
		Color ="#9A8BE0" />

	<SolidColorBrush
		x:Key ="OutputSectionBrush"
		Color ="#2A261D" />

	<SolidColorBrush
		x:Key ="OutputAccentBrush"
		Color ="#D6A04A" />

	<!-- Database explorer and column rules rows: alternating, selected, hidden and key states -->
	<SolidColorBrush
		x:Key ="RowBrush"
		Color ="#22272E" />

	<SolidColorBrush
		x:Key ="AlternateRowBrush"
		Color ="#282E36" />

	<SolidColorBrush
		x:Key ="DatabaseRowBrush"
		Color ="#253141" />

	<SolidColorBrush
		x:Key ="DatabaseAlternateRowBrush"
		Color ="#2A3748" />

	<SolidColorBrush
		x:Key ="SelectedRowBrush"
		Color ="#1F3D5C" />

	<SolidColorBrush
		x:Key ="SelectedRowBorderBrush"
		Color ="#4C8FD6" />

	<SolidColorBrush
		x:Key ="HoverOverlayBrush"
		Color ="#267AB2EC" />

	<SolidColorBrush
		x:Key ="HiddenRowBrush"
		Color ="#24272B" />

	<SolidColorBrush
		x:Key ="HiddenTextBrush"
		Color ="#6B737D" />

	<SolidColorBrush
		x:Key ="PrimaryKeyRowBrush"
		Color ="#4A2B2B" />

	<SolidColorBrush
		x:Key ="PrimaryKeyAlternateRowBrush"
		Color ="#543030" />

	<SolidColorBrush
		x:Key ="ForeignKeyRowBrush"
		Color ="#4A3623" />

	<SolidColorBrush
		x:Key ="ForeignKeyAlternateRowBrush"
		Color ="#543D27" />

	<!-- Status: validation and warning colours used by inputs, banners and icons -->
	<SolidColorBrush
		x:Key ="ErrorBrush"
		Color ="#FF8A80" />

	<SolidColorBrush
		x:Key ="ErrorBackgroundBrush"
		Color ="#3D2424" />

	<SolidColorBrush
		x:Key ="ErrorBorderBrush"
		Color ="#7A3A36" />

	<SolidColorBrush
		x:Key ="WarningBrush"
		Color ="#F0B45A" />

	<!-- Buttons, inputs and chrome: shared accents, borders, headers and status bar colours -->
	<SolidColorBrush
		x:Key ="AccentBrush"
		Color ="#3B82D0" />

	<SolidColorBrush
		x:Key ="AccentHoverBrush"
		Color ="#4A90DC" />

	<SolidColorBrush
		x:Key ="AccentPressedBrush"
		Color ="#2F6DB3" />

	<SolidColorBrush
		x:Key ="ButtonBackgroundBrush"
		Color ="#2A3038" />

	<SolidColorBrush
		x:Key ="ButtonBorderBrush"
		Color ="#46505C" />

	<SolidColorBrush
		x:Key ="ButtonHoverBackgroundBrush"
		Color ="#33404F" />

	<SolidColorBrush
		x:Key ="ButtonHoverBorderBrush"
		Color ="#5A9BE0" />

	<SolidColorBrush
		x:Key ="ButtonPressedBackgroundBrush"
		Color ="#2B4A6B" />

	<SolidColorBrush
		x:Key ="InputBackgroundBrush"
		Color ="#1E2329" />

	<SolidColorBrush
		x:Key ="InputBorderBrush"
		Color ="#4A5360" />

	<SolidColorBrush
		x:Key ="HeaderStripBrush"
		Color ="#2A3038" />

	<SolidColorBrush
		x:Key ="GridLineBrush"
		Color ="#323942" />

	<SolidColorBrush
		x:Key ="StatusBarBrush"
		Color ="#16191D" />

	<SolidColorBrush
		x:Key ="StatusBarBorderBrush"
		Color ="#2E343C" />

	<!-- Pop-ups, hints and scroll bars: floating surfaces and scroll thumb colours -->
	<SolidColorBrush
		x:Key ="PopupBackgroundBrush"
		Color ="#252B33" />

	<SolidColorBrush
		x:Key ="ToolTipBackgroundBrush"
		Color ="#2A3038" />

	<SolidColorBrush
		x:Key ="ToolTipBorderBrush"
		Color ="#4A5360" />

	<SolidColorBrush
		x:Key ="ScrollBarTrackBrush"
		Color ="#20252B" />

	<SolidColorBrush
		x:Key ="ScrollBarThumbBrush"
		Color ="#4A5360" />

	<SolidColorBrush
		x:Key ="ScrollBarThumbHoverBrush"
		Color ="#5E6977" />

	<!-- Key badges: small labels for primary keys, foreign keys, identity columns and row sets -->
	<SolidColorBrush
		x:Key ="PrimaryKeyBadgeBrush"
		Color ="#7A3530" />

	<SolidColorBrush
		x:Key ="PrimaryKeyBadgeTextBrush"
		Color ="#FFD9D5" />

	<SolidColorBrush
		x:Key ="ForeignKeyBadgeBrush"
		Color ="#7A4F22" />

	<SolidColorBrush
		x:Key ="ForeignKeyBadgeTextBrush"
		Color ="#FFE3C4" />

	<SolidColorBrush
		x:Key ="ForeignTableKeyBadgeBrush"
		Color ="#4A3A22" />

	<SolidColorBrush
		x:Key ="ForeignTableKeyBadgeBorderBrush"
		Color ="#C08A44" />

	<SolidColorBrush
		x:Key ="IdentityBadgeBrush"
		Color ="#33475B" />

	<SolidColorBrush
		x:Key ="IdentityBadgeTextBrush"
		Color ="#D8E3F0" />

	<SolidColorBrush
		x:Key ="RowSetBadgeBrush"
		Color ="#3B3466" />

	<SolidColorBrush
		x:Key ="RowSetBadgeTextBrush"
		Color ="#DCD5FF" />

	<!-- System colours: standard control templates without custom styles match the dark palette -->
	<SolidColorBrush
		x:Key ="{x:Static SystemColors.WindowBrushKey}"
		Color ="#22272E" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.WindowTextBrushKey}"
		Color ="#E3E8EE" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.ControlBrushKey}"
		Color ="#20252B" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.ControlTextBrushKey}"
		Color ="#E3E8EE" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.GrayTextBrushKey}"
		Color ="#8A949F" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.InfoBrushKey}"
		Color ="#2A3038" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.InfoTextBrushKey}"
		Color ="#E3E8EE" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.MenuBrushKey}"
		Color ="#252B33" />

	<SolidColorBrush
		x:Key ="{x:Static SystemColors.MenuTextBrushKey}"
		Color ="#E3E8EE" />
</ResourceDictionary>